module ZeronGrammar;

# IDENTIFIER, INT, DOUBLE, and STRING denote scanner token kinds.
# `type` below is source syntax; design-document-02 describes encoded descriptors.

program                 : [packageDeclaration] {importDeclaration} {topLevelDeclaration} EOF ;
packageDeclaration      : "package" qualifiedName ";" ;
qualifiedName           : IDENTIFIER {"." IDENTIFIER} ;
importDeclaration       : "import" qualifiedName ["as" IDENTIFIER] ";" ;

topLevelDeclaration     : varDecl | funDecl | classDecl | contractDecl
                        | externalFunctionDecl | publicFunDecl | publicExternalFunctionDecl
                        | publicClassDecl | publicContractDecl ;
publicFunDecl           : "public" funDecl ;
publicExternalFunctionDecl : "public" externalFunctionDecl ;
publicClassDecl         : "public" classDecl ;
publicContractDecl      : "public" contractDecl ;
declaration             : varDecl | funDecl | statement ;

varDecl                 : "let" ["mut"] IDENTIFIER [":" type] ["=" expression] ";" ;
funDecl                 : "fn" IDENTIFIER [typeParameters] "(" parameters ")" [":" type]
                          ("=" expression ";" | block) ;
externalFunctionDecl   : "external" "fn" IDENTIFIER "(" parameters ")" ":" type ";" ;
typeParameters          : "<" typeParameter {"," typeParameter} ">" ;
typeParameter           : IDENTIFIER [":" type] ;
parameters              : [parameter {"," parameter}] ;
parameter               : IDENTIFIER ":" type ;

classDecl               : "class" IDENTIFIER [typeParameters]
                          ["is" contractUse {"," contractUse}]
                          "{" classMember* "}" ;
contractUse             : qualifiedName [typeArguments] ;
classMember             : fieldDecl | propertyDecl | constructorDecl | namedConstructorDecl | methodDecl ;
fieldDecl               : IDENTIFIER ":" type ";" ;
propertyDecl            : visibility ["mut"] "property" IDENTIFIER ":" type ["=" expression]
                          (";" | "{" propertyAccessor+ "}") ;
propertyAccessor        : "get" ("=" expression ";" | block)
                        | "set" "(" IDENTIFIER ")" ("=" expression ";" | block) ;
constructorDecl         : visibility "constructor" "new" ";" ;
namedConstructorDecl    : visibility "constructor" IDENTIFIER "(" parameters ")"
                          ("=" expression ";" | block) ;
methodDecl              : visibility ["mut"] IDENTIFIER [typeParameters] "(" parameters ")" ":" type
                          ("=" expression ";" | block) ;
contractDecl            : "contract" IDENTIFIER [typeParameters] "{" contractMember* "}" ;
contractMember          : contractProperty | contractMethod ;
contractProperty        : ["mut"] "property" IDENTIFIER ":" type ";" ;
contractMethod          : ["default"] ["mut"] IDENTIFIER [typeParameters] "(" parameters ")" ":" type
                          (";" | "=" expression ";" | block) ;
visibility              : "public" | "private" ;

statement               : exprStmt
                        | breakStmt
                        | continueStmt
                        | forStmt
                        | ifStmt
                        | returnStmt
                        | loopStmt
                        | whileStmt
                        | untilStmt
                        | block ;
exprStmt                : expression ";" ;
breakStmt               : "break" ";" ;
continueStmt            : "continue" ";" ;
forStmt                 : "for" "(" "let" IDENTIFIER "in" expression ")" statement ;
ifStmt                  : "if" "(" expression ")" statement ["else" statement] ;
returnStmt              : "return" [expression] ";" ;
loopStmt                : "loop" statement ;
whileStmt               : "while" "(" expression ")" statement ;
untilStmt               : "until" "(" expression ")" statement ;
block                   : "{" { declaration } "}" ;

expression              : assignment ;
assignment              : coalesce [assignmentOperator assignment] ;
assignmentOperator      : "=" | "+=" | "-=" | "*=" | "/=" | "%="
                        | "&=" | "|=" | "^=" | "<<=" | ">>=" | ">>>=" | "??=" ;
coalesce                : logicOr ["??" coalesce] ;
logicOr                 : logicAnd {"or" logicAnd} ;
logicAnd                : bitwiseOr {"and" bitwiseOr} ;
bitwiseOr               : bitwiseXor {"|" bitwiseXor} ;
bitwiseXor              : bitwiseAnd {"^" bitwiseAnd} ;
bitwiseAnd              : equality {"&" equality} ;
equality                : typeTest {("!=" | "==" | "===") typeTest} ;
typeTest                : comparison ["is" ["not"] type] ;
comparison              : shift {(">" | ">=" | "<" | "<=") shift} ;
shift                   : term {("<<" | ">>" | ">>>") term} ;
term                    : factor {("-" | "+") factor} ;
factor                  : unary {("/" | "*" | "%") unary} ;
unary                   : ("not" | "-" | "+" | "~" | "typeof") unary
                        | cast ;
cast                    : call {"as" ["?"] type} ;
call                    : (genericFunctionCall | genericClassFactoryCall | functionValueReference | primary)
                          {callSuffix} ;
callSuffix              : arguments | "[" expression "]" | ("." | "?.") IDENTIFIER ;
genericFunctionCall     : IDENTIFIER typeArguments arguments ;
functionValueReference : IDENTIFIER "::" typeArguments ;
genericClassFactoryCall : IDENTIFIER typeArguments "." IDENTIFIER arguments ;
arguments               : "(" [expression {"," expression}] ")" ;
typeArguments           : "<" type {"," type} ">" ;
type                    : ["&"] typeAtom ["?"] ;
typeAtom                : qualifiedName ["<" typeArgumentsBody ">"]
                        | "(" ")" "->" type
                        | "(" type ")" ["->" type]
                        | "(" type "," type {"," type} ")" "->" type ;
typeArgumentsBody       : type {"," type} ;

primary                 : INT
                        | DOUBLE
                        | STRING
                        | IDENTIFIER
                        | arrayLiteral
                        | lambda
                        | "true" | "false" | "null" | "unit" | "this"
                        | ifExpr
                        | "(" expression ")"
                        | range ;
arrayLiteral            : "[" expression {"," expression} "]" ;
ifExpr                  : "if" "(" expression ")" "then" expression "else" expression ;
lambda                  : IDENTIFIER "->" lambdaBody
                        | "(" [IDENTIFIER {"," IDENTIFIER}] ")" "->" lambdaBody ;
lambdaBody              : expression | block ;
range                   : INT ".." INT ;

# Semantic/parser constraints:
# - Classes and contracts are top-level declarations; each class has exactly one canonical constructor.
# - The canonical `new` declaration may be omitted, which synthesizes a public canonical constructor.
#   An explicit `private constructor new;` makes canonical construction private.
# - Fields and auto-properties may have initializers. Initialized members are omitted from canonical
#   constructor parameters. Uninitialized fields are parameters first, followed by uninitialized
#   auto-properties, each in declaration order within its group.
# - A visibility-marked class `property` has a generated getter; `mut` adds a generated setter which
#   requires a mutable receiver. A custom accessor block replaces generated accessors. Custom
#   properties require a getter and use explicitly declared fields for backing storage.
# - Contracts may require read-only properties (`property name: Type;`) or writable properties
#   (`mut property name: Type;`). Implementations may use auto or custom accessors.
# - Named constructors are static factories with explicit visibility and either expression or block
#   bodies. Their result type is implicitly `&Class`, they have no `this`, and every reachable normal
#   path in a block must return an `&Class` value. Allocation still uses the canonical `Class.new`.
# - Generic functions and methods must have explicit return types. Method type parameters are
#   unbounded, scoped to that method, and cannot shadow enclosing class or contract parameters.
#   Calls infer type arguments from arguments or accept explicit arguments before the argument list.
# - Generic function values use `name::<Type, ...>` for explicit specialization, or a bare name
#   when an expected function type determines every type parameter. These values are monomorphic.
# - Generic functions may constrain a type parameter with one contract bound (`T: Contract`). Class
#   and contract type-parameter bounds, multiple bounds, and mutating bound methods remain unsupported.
# - Generic function calls use a bare identifier; generic class factories use Type<Args>.name(...).
# - Project compilation uses explicit source roots and an entry file. Cross-package source units may
#   declare classes, contracts, and functions; cross-package top-level values are deferred.
#   Selective class/contract/function imports may use `as` aliases and require public declarations.
# - Non-entry functions require explicit return annotations so signatures are available up front.
# - External functions are top-level signature-only declarations. Their implementation is selected
#   by a compiler-side typed binding registry keyed by the source-qualified function name.
# - `..` constructs an inclusive `zeron.ranges.IntRange`; `for` accepts arrays and values conforming
#   to the bundled Iterable<T> contract.
# - Output uses ordinary imported calls to `zeron.io.print` and `zeron.io.println`; `print` is not a
#   statement keyword.
# - Assignment targets are variables, properties, or array indices. Compound assignment is supported
#   for variables and writable properties; property receivers are evaluated once, then the getter,
#   operator, and setter run in that order. Indexed assignment accepts '=' only.
# - `%` accepts matching `Int` or `Float` operands and follows JVM remainder semantics. Bitwise `&`,
#   `|`, `^`, `~` and shifts require `Int`; `>>>` is zero-filling. Shift distances follow JVM Int
#   behavior (only the low five bits are used).
# - Array literals are non-empty. A valueless `return` has type Unit and is rejected in non-Unit functions.
#   Type argument arity is checked by resolution.
# Parser productions describe syntax; declaration, type-argument, and return-flow constraints are
# enforced by resolution.
