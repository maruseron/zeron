{
  "name": "zeron-language-support",
  "displayName": "Zeron Language Support",
  "description": "Language support for the Zeron programming language.",
  "version": "0.1.0",
  "publisher": "maruseron",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/maruseron/zeron.git",
    "directory": "editors/vscode"
  },
  "main": "./extension.js",
  "scripts": {
    "test": "node --test"
  },
  "activationEvents": [
    "onLanguage:zeron",
    "onCommand:zeron.restartLanguageServer",
    "onCommand:zeron.reloadWindow"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "commands": [
      {
        "command": "zeron.restartLanguageServer",
        "title": "Zeron: Restart Language Server"
      },
      {
        "command": "zeron.reloadWindow",
        "title": "Zeron: Reload Window"
      }
    ],
    "languages": [
      {
        "id": "zeron",
        "aliases": [
          "Zeron",
          "zeron"
        ],
        "extensions": [
          ".zn"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zeron",
        "scopeName": "source.zeron",
        "path": "./syntaxes/zeron.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Zeron",
      "properties": {
        "zeron.server.path": {
          "type": "string",
          "default": "zeron",
          "scope": "machine",
          "description": "Path or command used to launch Zeron. The extension appends the fixed 'lsp' subcommand."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "files": [
    "README.md",
    "extension.js",
    "stdlib-documents.js",
    "language-configuration.json",
    "node_modules/**",
    "syntaxes/**"
  ]
}
