{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Zeron",
  "scopeName": "source.zeron",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#for-expression"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#contextual-keywords"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#types"
    },
    {
      "include": "#function-calls"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.zeron",
          "begin": "//",
          "end": "$"
        },
        {
          "name": "comment.block.zeron",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.zeron",
      "begin": "\"",
      "end": "\""
    },
    "for-expression": {
      "name": "meta.for-expression.zeron",
      "begin": "\\b(for)(\\s+)([A-Za-z_][A-Za-z0-9_]*)(\\s+)(in)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.zeron"
        },
        "3": {
          "name": "variable.other.zeron"
        },
        "5": {
          "name": "keyword.control.zeron"
        }
      },
      "end": "\\b(yield|collect)\\b",
      "endCaptures": {
        "1": {
          "name": "keyword.control.zeron"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#contextual-keywords"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#types"
        },
        {
          "include": "#function-calls"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.zeron"
            },
            "2": {
              "name": "entity.name.function.zeron"
            }
          }
        },
        {
          "match": "\\b(handler)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\{)",
          "captures": {
            "1": {
              "name": "keyword.declaration.handler.zeron"
            },
            "2": {
              "name": "entity.name.constant.zeron"
            }
          }
        },
        {
          "match": "\\b(class|contract|effect|extension|type|witness)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.type.zeron"
            },
            "2": {
              "name": "entity.name.type.zeron"
            }
          }
        },
        {
          "match": "\\b(let)\\s+(?:(mut)\\s+)?([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.variable.zeron"
            },
            "2": {
              "name": "storage.modifier.mutability.zeron"
            },
            "3": {
              "name": "variable.other.zeron"
            }
          }
        },
        {
          "match": "\\b(newtype)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.type.zeron"
            },
            "2": {
              "name": "entity.name.type.zeron"
            }
          }
        }
      ]
    },
    "keywords": {
      "name": "keyword.control.zeron",
      "match": "\\b(?:and|as|break|case|class|contract|constructor|continue|default|else|effect|extension|external|fn|for|handle|if|implement|import|in|is|let|loop|match|mut|namespace|not|object|or|package|pattern|private|property|public|raise|raises|return|sealed|static|then|this|throws|type|typeof|until|using|witness|while)\\b"
    },
    "contextual-keywords": {
      "patterns": [
        {
          "match": "(?<=:)\\s*(nullable)\\b(?=\\s*(?:\\+|,|>))",
          "captures": {
            "1": {
              "name": "keyword.control.zeron"
            }
          }
        },
        {
          "match": "(?:(?<=<)|(?<=,))(\\s*)(out)\\b(?=\\s*[^,>])",
          "captures": {
            "2": {
              "name": "keyword.control.zeron"
            }
          }
        },
        {
          "name": "keyword.control.zeron",
          "match": "\\bderiving\\b(?=\\s+[A-Z][A-Za-z0-9_]*(?:\\s*,\\s*[A-Z][A-Za-z0-9_]*)*\\s*(?:=|\\{))"
        },
        {
          "name": "keyword.control.zeron",
          "match": "\\bwith\\b(?=\\s*\\{|\\s+suppressed\\b)"
        },
        {
          "name": "keyword.control.zeron",
          "match": "\\bwith\\b(?=\\s+[A-Za-z_][A-Za-z0-9_]*\\b)"
        },
        {
          "name": "keyword.control.zeron",
          "match": "\\bhandler\\b(?=\\s*(?:\\{|[A-Za-z_][A-Za-z0-9_]*\\s*\\{))"
        },
        {
          "name": "keyword.control.zeron",
          "match": "\\b(implementation)\\b(?=\\s+[A-Za-z_][A-Za-z0-9_]*\\s*<[^{};]*_[^{};]*>\\s*\\{)"
        },
        {
          "match": "\\b(import)(\\s+)(suffix)(?=\\s+[A-Za-z_])",
          "captures": {
            "1": {
              "name": "keyword.control.zeron"
            },
            "3": {
              "name": "keyword.control.zeron"
            }
          }
        },
        {
          "name": "meta.declaration.suffix.zeron",
          "begin": "\\b(suffix)\\s+([A-Za-z_][A-Za-z0-9_]*)(\\s*)(\\{)",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.zeron"
            },
            "2": {
              "name": "entity.name.constant.zeron"
            },
            "4": {
              "name": "punctuation.section.block.begin.zeron"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.block.end.zeron"
            }
          },
          "patterns": [
            {
              "match": "\\b(integer|decimal)(?=\\s*:)",
              "captures": {
                "1": {
                  "name": "keyword.control.zeron"
                }
              }
            },
            {
              "match": "\\b(string)(?=\\s+[A-Za-z_][A-Za-z0-9_]*\\s*;)",
              "captures": {
                "1": {
                  "name": "keyword.control.zeron"
                }
              }
            }
          ]
        },
        {
          "match": "(?:(?<=\\{)|^)\\s*(get)\\b(?=\\s*(?:=|\\{))",
          "captures": {
            "1": {
              "name": "keyword.control.zeron"
            }
          }
        }
      ]
    },
    "constants": {
      "name": "constant.language.zeron",
      "match": "\\b(?:false|null|true)\\b"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.zeron",
          "match": "\\b[0-9](?:_?[0-9])*\\.[0-9](?:_?[0-9])*(?!L\\b)[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "constant.numeric.integer.zeron",
          "match": "\\b(?:0[bB][01](?:_?[01])*|0[oO][0-7](?:_?[0-7])*|0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*|[0-9](?:_?[0-9])*)(?!L\\b)[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "constant.numeric.float.zeron",
          "match": "\\b[0-9](?:_?[0-9])*\\.[0-9](?:_?[0-9])*\\b"
        },
        {
          "name": "constant.numeric.integer.long.zeron",
          "match": "\\b(?:0[bB][01](?:_?[01])*|0[oO][0-7](?:_?[0-7])*|0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*|[0-9](?:_?[0-9])*)L\\b"
        },
        {
          "name": "constant.numeric.integer.zeron",
          "match": "\\b(?:0[bB][01](?:_?[01])*|0[oO][0-7](?:_?[0-7])*|0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*|[0-9](?:_?[0-9])*)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.builtin.zeron",
          "match": "\\b(?:Any|Boolean|Byte|ByteArray|Float|Int|Long|String|Unit)\\b"
        },
        {
          "name": "entity.name.type.zeron",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "function-calls": {
      "name": "entity.name.function.zeron",
      "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*\\()"
    },
    "operators": {
      "name": "keyword.operator.zeron",
      "match": "(?:===|==|!=|<=|>=|>>>=|>>>|>>=|>>|<<=|<<|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|\\.\\.\\.|\\.\\.|~>|->|\\?\\?=|\\?\\?|\\?\\.|::|[+*/%&|^~!<>=?:-])"
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.group.zeron",
          "match": "[(){}\\[\\]]"
        },
        {
          "name": "punctuation.separator.zeron",
          "match": "[,;.]"
        }
      ]
    }
  }
}
