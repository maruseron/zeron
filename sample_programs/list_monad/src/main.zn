fn main() {
    let list = List.from<Int>(1, 2, 3, 4, 5);
    println(list.map(i -> i * 2).toString());
    println(map(list, i -> i * 2).toString());
}

public fn map<T, R, E: effect...>(
    list: List<T>,
    transform: (T) -> R raises E
): List<R> raises E = match (list) {
    case List.Nil() -> List.Nil<R>();
    case List.Cons(head, tail) -> List.Cons(transform(head), map<T, R, E>(tail, transform));
};