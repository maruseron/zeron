package query.backend;

import query.error.QueryError;
import query.schema.Row;
import query.value.TableId;

import zeron.collections.ArrayList;
import zeron.lang.Result;

public class MemoryDatabase {
    users: ArrayList<Row>;
    orders: ArrayList<Row>;

    public rowsFor(table: TableId): Result<ArrayList<Row>, QueryError> {
        if (table == "users") return Result.Ok(this.users);
        if (table == "orders") return Result.Ok(this.orders);
        return Result<ArrayList<Row>, QueryError>.Err(QueryError.UnknownTable(table));
    }
}
