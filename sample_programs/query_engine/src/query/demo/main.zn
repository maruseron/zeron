package query.demo;

import query.dsl.from;
import query.engine.execute;
import query.error.QueryError;
import query.schema.Row;
import query.value.TableId;

import zeron.collections.ArrayList;

fn printRows(rows: ArrayList<Row>): Unit {
    for (let row in rows) println(row.render());
}

fn printError(error: QueryError): Unit = match (error) {
    case UnknownTable(name)  -> println("Unknown table: " + name);
    case MissingColumn(name) -> println("Missing column: " + name);
    case InvalidComparison() -> println("Invalid comparison");
    case InvalidPredicate()  -> println("Invalid predicate");
};

fn main() {
    let database = sampleDatabase();
    // The predicate and selector are inline lambdas over the typed schema views. The compiler
    // reifies them as CodeModels, and the DSL translates property reads to column names.
    let query = from(TableId.new("users"))
        .join(from(TableId.new("orders")), "id", "user_id")
        .where(user -> user.age <= 19 or user.name == "Ada")
        .select(["name", "amount"])
        .orderBy(order -> order.amount);

    match (execute(query, database)) {
        case Ok(rows) -> printRows(rows);
        case Err(error) -> printError(error);
    };
}
