package query.engine;

import query.ast.Expr;
import query.ast.QueryPlan;
import query.backend.MemoryDatabase;
import query.dsl.Query;
import query.error.QueryError;
import query.schema.Row;
import query.value.Value;

import zeron.collections.ArrayList;
import zeron.lang.Option;
import zeron.lang.Ordering;
import zeron.lang.Result;

public fn execute(query: Query, database: MemoryDatabase): Result<ArrayList<Row>, QueryError> =
    executePlan(query.toPlan(), database);

fn executePlan(
    plan: QueryPlan,
    database: MemoryDatabase
): Result<ArrayList<Row>, QueryError> = match (plan) {
    case Scan(table) -> database.rowsFor(table);
    case Filter(source, predicate) -> match (executePlan(source, database)) {
        case Ok(rows) -> filterRows(rows, predicate);
        case Err(error) -> Result<ArrayList<Row>, QueryError>.Err(error);
    };
    case Project(source, columns) -> match (executePlan(source, database)) {
        case Ok(rows) -> projectRows(rows, columns);
        case Err(error) -> Result<ArrayList<Row>, QueryError>.Err(error);
    };
    case Join(left, right, leftKey, rightKey) ->
        executeJoin(left, right, leftKey, rightKey, database);
    case OrderBy(source, column) -> match (executePlan(source, database)) {
        case Ok(rows) -> orderRows(rows, column);
        case Err(error) -> Result<ArrayList<Row>, QueryError>.Err(error);
    };
};

fn filterRows(rows: ArrayList<Row>, predicate: Expr): Result<ArrayList<Row>, QueryError> =
    filterRowsFrom(rows, predicate, 0, ArrayList<Row>.empty());

fn filterRowsFrom(
    rows: ArrayList<Row>,
    predicate: Expr,
    index: Int,
    filtered: &ArrayList<Row>
): Result<ArrayList<Row>, QueryError> =
    if (index >= rows.size) then Result<ArrayList<Row>, QueryError>.Ok(filtered)
    else match (evaluatePredicate(predicate, rowAt(rows, index))) {
        case Ok(keep) ->
            if (keep)
            then filterRowsFrom(rows, predicate, index + 1, appendRow(filtered, rowAt(rows, index)))
            else filterRowsFrom(rows, predicate, index + 1, filtered);
        case Err(error) -> Result<ArrayList<Row>, QueryError>.Err(error);
    };

fn projectRows(rows: ArrayList<Row>, columns: Array<String>): Result<ArrayList<Row>, QueryError> =
    projectRowsFrom(rows, columns, 0, ArrayList<Row>.empty());

fn projectRowsFrom(
    rows: ArrayList<Row>,
    columns: Array<String>,
    index: Int,
    projected: &ArrayList<Row>
): Result<ArrayList<Row>, QueryError> =
    if (index >= rows.size) then Result<ArrayList<Row>, QueryError>.Ok(projected)
    else match (rowAt(rows, index).project(columns)) {
        case Ok(row) ->
            projectRowsFrom(rows, columns, index + 1, appendRow(projected, row));
        case Err(error) -> Result<ArrayList<Row>, QueryError>.Err(error);
    };

fn executeJoin(
    left: QueryPlan,
    right: QueryPlan,
    leftKey: String,
    rightKey: String,
    database: MemoryDatabase
): Result<ArrayList<Row>, QueryError> = match (executePlan(left, database)) {
    case Ok(leftRows) -> match (executePlan(right, database)) {
        case Ok(rightRows) ->
            joinRows(leftRows, rightRows, leftKey, rightKey, 0, ArrayList<Row>.empty());
        case Err(error) -> Result<ArrayList<Row>, QueryError>.Err(error);
    };
    case Err(error) -> Result<ArrayList<Row>, QueryError>.Err(error);
};

fn joinRows(
    leftRows: ArrayList<Row>,
    rightRows: ArrayList<Row>,
    leftKey: String,
    rightKey: String,
    leftIndex: Int,
    joined: &ArrayList<Row>
): Result<ArrayList<Row>, QueryError> =
    if (leftIndex >= leftRows.size) then Result<ArrayList<Row>, QueryError>.Ok(joined)
    else joinRight(
        leftRows,
        rightRows,
        leftKey,
        rightKey,
        leftIndex,
        0,
        joined
    );

fn joinRight(
    leftRows: ArrayList<Row>,
    rightRows: ArrayList<Row>,
    leftKey: String,
    rightKey: String,
    leftIndex: Int,
    rightIndex: Int,
    joined: &ArrayList<Row>
): Result<ArrayList<Row>, QueryError> =
    if (rightIndex >= rightRows.size) then
        joinRows(leftRows, rightRows, leftKey, rightKey, leftIndex + 1, joined)
    else match (rowAt(leftRows, leftIndex).get(leftKey)) {
        case Ok(leftValue) -> match (rowAt(rightRows, rightIndex).get(rightKey)) {
            case Ok(rightValue) ->
                joinRight(
                    leftRows,
                    rightRows,
                    leftKey,
                    rightKey,
                    leftIndex,
                    rightIndex + 1,
                    appendJoined(
                        joined,
                        rowAt(leftRows, leftIndex),
                        rowAt(rightRows, rightIndex),
                        equalValues(leftValue, rightValue)
                    )
                );
            case Err(error) -> Result<ArrayList<Row>, QueryError>.Err(error);
        };
        case Err(error) -> Result<ArrayList<Row>, QueryError>.Err(error);
    };

fn orderRows(rows: ArrayList<Row>, column: String): Result<ArrayList<Row>, QueryError> =
    match (missingColumn(rows, column)) {
        case Some(error) -> Result<ArrayList<Row>, QueryError>.Err(error);
        case None() -> Result<ArrayList<Row>, QueryError>.Ok(
            rows.sortedBy((left, right) -> compareRows(left, right, column)));
    };

fn missingColumn(rows: ArrayList<Row>, column: String): Option<QueryError> =
    if (rows.isEmpty()) then Option.None<QueryError>()
    else match (rowAt(rows, 0).get(column)) {
        case Ok(_) -> Option.None<QueryError>();
        case Err(error) -> Option.Some(error);
    };

fn compareRows(left: Row, right: Row, column: String): Ordering =
    match (compareRowValues(left, right, column)) {
        case Ok(order) ->
            if (order < 0) then Ordering.LT()
            else if (order > 0) then Ordering.GT()
            else Ordering.EQ();
        // Missing columns are rejected before sorting; a mixed-type row compares equal.
        case Err(_) -> Ordering.EQ();
    };

fn compareRowValues(left: Row, right: Row, column: String): Result<Int, QueryError> =
    match (left.get(column)) {
        case Ok(leftValue) -> match (right.get(column)) {
            case Ok(rightValue) -> compareValues(leftValue, rightValue);
            case Err(error) -> Result<Int, QueryError>.Err(error);
        };
        case Err(error) -> Result<Int, QueryError>.Err(error);
    };

/// Returns the row at an in-range index. Callers guard every access with `size`.
fn rowAt(rows: ArrayList<Row>, index: Int): Row =
    rows.at(index).getOrElse(Row.new(ArrayList<String>.empty(), ArrayList<Value>.empty()));

fn appendRow(rows: &ArrayList<Row>, row: Row): &ArrayList<Row> {
    rows.add(row);
    return rows;
}

fn appendJoined(
    rows: &ArrayList<Row>,
    left: Row,
    right: Row,
    shouldJoin: Boolean
): &ArrayList<Row> =
    if (shouldJoin) then appendRow(rows, left.merge(right)) else rows;
