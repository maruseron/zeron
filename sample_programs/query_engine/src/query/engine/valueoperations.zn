package query.engine;

import query.error.QueryError;
import query.value.Value;

import zeron.lang.Result;

public fn equalValues(left: Value, right: Value): Boolean = match (left) {
    case Integer(leftNumber) -> match (right) {
        case Integer(rightNumber) -> leftNumber == rightNumber;
        case _ -> false;
    };
    case Decimal(leftNumber) -> match (right) {
        case Decimal(rightNumber) -> leftNumber == rightNumber;
        case _ -> false;
    };
    case Text(leftText) -> match (right) {
        case Text(rightText) -> leftText == rightText;
        case _ -> false;
    };
    case Flag(leftFlag) -> match (right) {
        case Flag(rightFlag) -> leftFlag == rightFlag;
        case _ -> false;
    };
    case Null() -> match (right) {
        case Null() -> true;
        case _ -> false;
    };
};

public fn compareValues(left: Value, right: Value): Result<Int, QueryError> = match (left) {
    case Integer(leftNumber) -> match (right) {
        case Integer(rightNumber) -> compareIntegers(leftNumber, rightNumber);
        case _ -> Result<Int, QueryError>.Err(QueryError.InvalidComparison());
    };
    case Decimal(leftNumber) -> match (right) {
        case Decimal(rightNumber) -> compareDecimals(leftNumber, rightNumber);
        case _ -> Result<Int, QueryError>.Err(QueryError.InvalidComparison());
    };
    case _ -> Result<Int, QueryError>.Err(QueryError.InvalidComparison());
};

fn compareIntegers(left: Int, right: Int): Result<Int, QueryError> =
    if (left < right) then Result<Int, QueryError>.Ok(-1)
    else if (left > right) then Result<Int, QueryError>.Ok(1)
    else Result<Int, QueryError>.Ok(0);

fn compareDecimals(left: Float, right: Float): Result<Int, QueryError> =
    if (left < right) then Result<Int, QueryError>.Ok(-1)
    else if (left > right) then Result<Int, QueryError>.Ok(1)
    else Result<Int, QueryError>.Ok(0);
