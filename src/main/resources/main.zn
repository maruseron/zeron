import zeron.io.println;
import zeron.lang.Some;
import zeron.lang.None;
import zeron.lang.some as someOf;

fn main() {
    let some = someOf("Hello");
    let result = match (some) {
        case Some<String> as s -> s.value() + " world!";
        case None<String> as n -> ".";
    };
    println(result);
}

fn wrong() {
    let res = null;
}