import zeron.collections.*;

class Person {
    public property name: String;
    public property age: Int;
}

class PrintingSink<T> is Sink<T> {
    public constructor empty() = PrintingSink.new();
    public mut add(value: T): Unit = println(value);
}

fn empty<C, T: Sink<C>>(): T = T.empty();

fn main() {
    let users = [Person.new("marcelo", 24), Person.new("dario", 56)];

    let result = for users
        filter user -> user.age > 30
        map user -> user.name;

    let nums = [1, 2, 3, 4, 5, 6];

    let evenSquared = for nums
        flatMap i -> List<Int>.of(i, i + 10)
        filter i -> i % 2 == 0
        map i -> i * i
        collect empty<Int, List<Int>>();

    println(evenSquared);
}