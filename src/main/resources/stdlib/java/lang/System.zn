package java.lang;

import java.io.PrintStream;

public external class System = "java.lang.System" {
    public static property out: &PrintStream?;
    public static getenv(name: String?): String?;
    public static getProperty(key: String?): String?;
    public static identityHashCode(value: Any?): Int;
    public static nanoTime(): Long;
    public static exit(status: Int): Unit;
}
