package zeron.collections;

class SequenceValue<T> {
    item: T;

    private constructor new;

    public constructor from(value: T) = SequenceValue<T>.new(value);

    public itemValue(): T = this.item;
}

class ArraySequence<T> is Iterable<T> {
    values: Array<T>;

    private constructor new;

    public constructor from(values: Array<T>) = ArraySequence<T>.new(values);

    public iterator(): &Iterator<T> = ArrayIterator<T>.from(this.values);
}

class MappedSequence<T, R> is Iterable<R> {
    source: Iterable<T>;
    transform: (T) -> R;

    private constructor new;

    public constructor from(source: Iterable<T>, transform: (T) -> R) =
        MappedSequence<T, R>.new(source, transform);

    public iterator(): &Iterator<R> =
        MappedIterator<T, R>.from(this.source.iterator(), this.transform);
}

class MappedIterator<T, R> is Iterator<R> {
    source: &Iterator<T>;
    transform: (T) -> R;

    private constructor new;

    public constructor from(source: &Iterator<T>, transform: (T) -> R) =
        MappedIterator<T, R>.new(source, transform);

    public mut hasNext(): Boolean = this.source.hasNext();

    public mut next(): R {
        let transform = this.transform;
        return transform(this.source.next());
    }
}

class FilteredSequence<T> is Iterable<T> {
    source: Iterable<T>;
    predicate: (T) -> Boolean;

    private constructor new;

    public constructor from(source: Iterable<T>, predicate: (T) -> Boolean) =
        FilteredSequence<T>.new(source, predicate);

    public iterator(): &Iterator<T> =
        FilteredIterator<T>.from(this.source.iterator(), this.predicate);
}

class FilteredIterator<T> is Iterator<T> {
    source: &Iterator<T>;
    predicate: (T) -> Boolean;
    buffered: SequenceValue<T>?;

    private constructor new;

    public constructor from(source: &Iterator<T>, predicate: (T) -> Boolean) =
        FilteredIterator<T>.new(source, predicate, null);

    public mut hasNext(): Boolean {
        if (this.buffered != null) return true;
        while (this.source.hasNext()) {
            let value = this.source.next();
            let predicate = this.predicate;
            if (predicate(value)) {
                this.buffered = SequenceValue<T>.from(value);
                return true;
            }
        }
        return false;
    }

    public mut next(): T {
        this.hasNext();
        let value = this.buffered;
        if (value != null) {
            this.buffered = null;
            return value.itemValue();
        }
        return this.source.next();
    }
}

class TakenSequence<T> is Iterable<T> {
    source: Iterable<T>;
    count: Int;

    private constructor new;

    public constructor from(source: Iterable<T>, count: Int) =
        TakenSequence<T>.new(source, count);

    public iterator(): &Iterator<T> =
        TakenIterator<T>.from(this.source.iterator(), this.count);
}

class TakenIterator<T> is Iterator<T> {
    source: &Iterator<T>;
    remaining: Int;

    private constructor new;

    public constructor from(source: &Iterator<T>, count: Int) =
        TakenIterator<T>.new(source, count);

    public mut hasNext(): Boolean = this.remaining > 0 and this.source.hasNext();

    public mut next(): T {
        let value = this.source.next();
        this.remaining = this.remaining - 1;
        return value;
    }
}

class DroppedSequence<T> is Iterable<T> {
    source: Iterable<T>;
    count: Int;

    private constructor new;

    public constructor from(source: Iterable<T>, count: Int) =
        DroppedSequence<T>.new(source, count);

    public iterator(): &Iterator<T> =
        DroppedIterator<T>.from(this.source.iterator(), this.count);
}

class DroppedIterator<T> is Iterator<T> {
    source: &Iterator<T>;
    count: Int;
    initialized: Boolean;

    private constructor new;

    public constructor from(source: &Iterator<T>, count: Int) =
        DroppedIterator<T>.new(source, count, false);

    public mut hasNext(): Boolean {
        if (not this.initialized) {
            let mut skipped = 0;
            while (skipped < this.count and this.source.hasNext()) {
                this.source.next();
                skipped += 1;
            }
            this.initialized = true;
        }
        return this.source.hasNext();
    }

    public mut next(): T {
        this.hasNext();
        return this.source.next();
    }
}

public class Sequence<T> is Iterable<T> {
    source: Iterable<T>;

    private constructor new;

    public constructor from(source: Iterable<T>) = Sequence<T>.new(source);

    public constructor fromArray(source: Array<T>) =
        Sequence<T>.new(ArraySequence<T>.from(source));

    private constructor wrap(source: Iterable<T>) = Sequence<T>.new(source);

    public iterator(): &Iterator<T> = this.source.iterator();

    public map<R>(transform: (T) -> R): Sequence<R> =
        Sequence<R>.wrap(MappedSequence<T, R>.from(this.source, transform));

    public filter(predicate: (T) -> Boolean): Sequence<T> =
        Sequence<T>.wrap(FilteredSequence<T>.from(this.source, predicate));

    public take(count: Int): Sequence<T> =
        Sequence<T>.wrap(TakenSequence<T>.from(this.source, count));

    public drop(count: Int): Sequence<T> =
        Sequence<T>.wrap(DroppedSequence<T>.from(this.source, count));

    public forEach(action: (T) -> Unit): Unit {
        let mut iterator = this.iterator();
        while (iterator.hasNext()) {
            action(iterator.next());
        }
    }

    public fold<R>(initial: R, combine: (R, T) -> R): R {
        let mut result = initial;
        let mut iterator = this.iterator();
        while (iterator.hasNext()) {
            result = combine(result, iterator.next());
        }
        return result;
    }

    public count(): Int {
        let mut result = 0;
        let mut iterator = this.iterator();
        while (iterator.hasNext()) {
            iterator.next();
            result += 1;
        }
        return result;
    }

    public any(predicate: (T) -> Boolean): Boolean {
        let mut iterator = this.iterator();
        while (iterator.hasNext()) {
            if (predicate(iterator.next())) return true;
        }
        return false;
    }

    public all(predicate: (T) -> Boolean): Boolean {
        let mut iterator = this.iterator();
        while (iterator.hasNext()) {
            if (not predicate(iterator.next())) return false;
        }
        return true;
    }
}
