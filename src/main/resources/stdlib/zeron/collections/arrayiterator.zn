package zeron.collections;

public class ArrayIterator<T: nullable + mut> is Iterator<T> {
    arr: Array<T>;
    current: Int;

    private constructor new;

    public constructor from(arr: Array<T>) = ArrayIterator<T>.new(arr, 0);

    public mut next(): Step<T> {
        if (this.current >= this.arr.length) return Step<T>.Done();
        let value = this.arr[this.current];
        this.current = this.current + 1;
        return Step.Yield(value);
    }
}
