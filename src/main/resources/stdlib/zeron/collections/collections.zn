package zeron.collections;

import zeron.internal.unwrapSome;
import zeron.lang.Hashable;
import zeron.lang.Pair;
import zeron.numeric.Integer;
import zeron.numeric.Numeric;

fn reversedConsList<T admits mutable>(values: ConsList<T>): ConsList<T> {
    let mut result: ConsList<T> = ConsList<T>.empty();
    for (let item in values) result = result.prepend(item);
    return result;
}

/// A collection whose elements are addressed by position in constant time.
///
/// Implementations must guarantee `O(1)` access for `at`.
public contract RandomAccess<T admits mutable> {
    /// Returns the element at `index`, or `None` when the index is out of range.
    at(index: Int): Option<T>;
}

/// A collection with a known, constant-time element count.
///
/// Finiteness is anchored in the signature: `size` can only be answered by a collection that ends.
/// A value that can only be counted by traversal is an `Iterable`, not a `Sized` collection.
public contract Sized<T admits mutable> requires Iterable<T> {
    /// The number of elements the collection holds.
    property size: Int;
}

/// A collection with a defined first and last element.
public contract Sequenced<T admits mutable> {
    /// Returns the first element, or `None` when the collection is empty.
    first(): Option<T>;
    /// Returns the last element, or `None` when the collection is empty.
    ///
    /// Implementations are not required to find the last element in constant time.
    last(): Option<T>;
}

/// A sequence that can add and remove elements at both ends.
///
/// A deque is a `List` and exposes its first and last elements through `Sequenced`. Implementations
/// may provide constant-time access at both ends; the contract does not require it.
public contract Deque<T admits mutable> requires List<T> + Sequenced<T> {
    /// Adds `value` at the initial end of the sequence.
    mut addFirst(value: T): Unit;

    /// Adds `value` at the final end of the sequence.
    mut addLast(value: T): Unit;

    /// Removes and returns the first element, or `None` when the sequence is empty.
    mut removeFirst(): Option<T>;

    /// Removes and returns the last element, or `None` when the sequence is empty.
    mut removeLast(): Option<T>;
}

/// A collection that can produce a reversed copy.
///
/// Reversing changes the order of the elements only; element values themselves are not modified.
public contract Reversible<C<_>> {
    /// Returns a reversed copy, leaving the receiver unchanged.
    reversed<T>(this: C<T>): C<T>;
}

/// A collection that can be reversed in place.
///
/// Persistent implementations provide `Reversible` and do not declare this capability.
public contract InPlaceReversible<C<_>> {
    /// Reverses the collection in place and returns it.
    mut reverse<T>(this: C<T>): C<T>;
}

/// A collection that can produce a reordered copy.
public contract Sortable<C<_>> {
    /// Returns a sorted copy, leaving the receiver unchanged.
    sortedBy<T admits mutable>(this: C<T>, compare: (T, T) -> Ordering): C<T>;

    /// Returns a copy sorted by the natural order of its elements.
    default sorted<T: Comparable<T> admits mutable>(this: C<T>): C<T> =
        this.sortedBy((a, b) -> a.compareTo(b));
}

/// A collection that can be reordered in place.
public contract InPlaceSortable<C<_>> {
    /// Sorts the collection in place, using `compare` to order pairs of elements.
    ///
    /// The sort is stable only if an implementation documents it as such.
    mut sortBy<T admits mutable>(this: C<T>, compare: (T, T) -> Ordering): Unit;

    /// Sorts the collection in place using the natural order of its elements.
    default mut sort<T: Comparable<T> admits mutable>(this: &C<T>): Unit =
        this.sortBy((a, b) -> a.compareTo(b));
}

/// A collection that accepts added values.
public contract Sink<T admits mutable> {
    /// Adds `value` to the collection, returning `true` when it was accepted.
    ///
    /// Collections that reject duplicates report `false` for an element they already hold.
    mut add(value: T): Boolean;
}

/// A collection that can be edited by position.
///
/// A list that cannot be edited in place, such as a persistent or linked list, does not declare this
/// capability.
public contract PositionalEditor<T admits mutable> {
    /// Inserts `value` before the element currently at `index`, returning `false` when the index is
    /// out of range.
    mut insert(index: Int, value: T): Boolean;

    /// Removes the element at `index` and returns it, or `None` when the index is out of range.
    mut removeAt(index: Int): Option<T>;

    /// Replaces the element at `index` and returns the previous element, or `None` when the index is
    /// out of range.
    mut replaceAt(index: Int, value: T): Option<T>;
}

/// A collection that can drop a value by equality.
public contract Removable<T admits mutable> {
    /// Removes one occurrence of `value`, returning `true` when it was present.
    mut remove(value: T): Boolean;
}

/// An associative collection that accepts writes by key.
///
/// The callbacks run during the call, so their effect row propagates to the caller.
public contract KeyedSink<K, V admits mutable> {
    /// Stores `value` for `key`, returning the value it replaced or `None` for a new key.
    mut put(key: K, value: V): Option<V>;

    /// Stores `value` only when `key` is absent, returning the previously stored value, if any.
    mut putIfAbsent(key: K, value: V): Option<V>;

    /// Recomputes the entry for `key` from its current value, storing or removing it as the result
    /// says, and returns that result.
    mut compute<E admits effect...>(
        key: K,
        transform: (K, Option<V>) -> Option<V> performs E
    ): Option<V> performs E;

    /// Returns the value stored for `key`, computing and storing `transform(key)` when absent.
    mut computeIfAbsent<E admits effect...>(key: K, transform: (K) -> V performs E): V performs E;

    /// Removes the entry for `key`, returning the value it held or `None` when the key is absent.
    mut remove(key: K): Option<V>;
}

/// A collection whose elements can all be discarded at once.
public contract Clearable {
    /// Removes every element.
    mut clear(): Unit;
}

/// A collection family that can be constructed and populated generically.
public contract CollectionBuilder<C<_>> {
    /// Creates a new empty, mutable collection.
    empty<A admits mutable>(): &C<A>;

    /// Adds `value` to `this`, returning `true` when it was accepted.
    mut add<A admits mutable>(this: C<A>, value: A): Boolean;
}

/// Accumulates items into one result.
///
/// A collector adds one item at a time with `add` and returns the final value from `finish`. How an
/// implementation accumulates is its own business: a joiner appends text, a list builder appends
/// elements, and a summary computes along the way. `add` returns the updated collector, so a
/// collector is an ordinary value and one instance can start many accumulations. Use
/// `Collector.of` when no dedicated implementation exists.
public contract Collector<T admits mutable, R admits mutable> {
    /// Returns a collector that holds `value` after the items already collected.
    mut add(value: T): Boolean;

    /// Returns the collected result.
    finish(): R;
}

/// Builders for collectors that have no dedicated implementation.
namespace Collector {
    /// Creates a collector that starts from `initial`, folds with `add`, and converts the final
    /// accumulator with `finish`.
    ///
    /// The accumulator and its conversions are an implementation detail of the returned collector;
    /// callers see only `add` and `finish`.
    public fn of<S admits mutable, T admits mutable, R admits mutable>(
        initial: S,
        add: (S, T) -> S,
        finish: (S) -> R
    ): &Collector<T, R> = CollectorImpl<T, S, R>.of(initial, add, finish);

    /// Creates a collector that gathers the items into a new `ArrayList`, in encounter order.
    public fn toArrayList<T admits mutable>(): &Collector<T, &ArrayList<T>> =
        Collector.of<& ArrayList<T>, T, &ArrayList<T>>(
            ArrayList<T>.empty(),
            (values, item) -> {
                values.add(item);
                return values;
            },
            (values) -> values
        );

    /// Creates a collector that gathers the items into a new `LinkedList`, in encounter order.
    public fn toLinkedList<T admits mutable>(): &Collector<T, &LinkedList<T>> =
        Collector.of<& LinkedList<T>, T, &LinkedList<T>>(
            LinkedList<T>.empty(),
            (values, item) -> {
                values.add(item);
                return values;
            },
            (values) -> values
        );

    /// Creates a collector that gathers the items into a new `ConsList`, in encounter order.
    ///
    /// A cons list prepends, so the collector builds in reverse and `finish` reverses the result.
    public fn toConsList<T admits mutable>(): &Collector<T, ConsList<T>> =
        Collector.of<ConsList<T>, T, ConsList<T>>(
            ConsList<T>.empty(),
            (values, item) -> values.prepend(item),
            (values) -> reversedConsList(values)
        );

    /// Creates a collector that gathers `key`/`value` pairs into a new `HashMap`.
    ///
    /// A later entry for an existing key replaces the earlier value.
    public fn toHashMap<K: Hashable<K>, V admits mutable>(): &Collector<Pair<K, V>, &HashMap<K, V>> =
        Collector.of<& HashMap<K, V>, Pair<K, V>, &HashMap<K, V>>(
            HashMap<K, V>.empty(),
            (entries, entry) -> {
                entries.put(entry.fst, entry.snd);
                return entries;
            },
            (entries) -> entries
        );

    /// Creates a collector that gathers the items into a new `HashSet`, dropping duplicates.
    public fn toHashSet<T: Hashable<T>>(): &Collector<T, &HashSet<T>> =
        Collector.of<& HashSet<T>, T, &HashSet<T>>(
            HashSet<T>.empty(),
            (elements, item) -> {
                elements.add(item);
                return elements;
            },
            (elements) -> elements
        );

    /// Creates a collector that adds the items together, starting from zero.
    public fn summing<T: Numeric<T>>(): &Collector<T, T> =
        Collector.of<T, T, T>(
            T.fromInteger(Integer.fromInt(0)),
            (total, value) -> total.add(value),
            (total) -> total
        );
}

/// The canonical collector returned by `Collector.of`.
class CollectorImpl<T admits mutable, S admits mutable, R admits mutable> is Collector<T, R> {
    state: S;
    step: (S, T) -> S;
    conversion: (S) -> R;

    private constructor new;

    public constructor of(initial: S, add: (S, T) -> S, finish: (S) -> R) =
        CollectorImpl<T, S, R>.new(initial, add, finish);

    public mut add(value: T): Boolean {
        this.state = this.step(this.state, value);
        return true;
    }

    public finish(): R = this.conversion(this.state);
}

/// Sorts `values` in place with `compare`.
///
/// The implementation is heapsort: `O(n log n)` comparisons, `O(1)` extra space, and not stable.
/// Collections that are not randomly accessible copy into an `ArrayList` buffer and sort that.
fn sortArrayList<T admits mutable>(values: &ArrayList<T>, compare: (T, T) -> Ordering): Unit {
    let size = values.size;
    let mut root = size / 2 - 1;
    while (root >= 0) {
        siftDownArrayList(values, root, size, compare);
        root -= 1;
    }

    let mut end = size - 1;
    while (end > 0) {
        swapArrayList(values, 0, end);
        siftDownArrayList(values, 0, end, compare);
        end -= 1;
    }
}

fn siftDownArrayList<T admits mutable>(
    values: &ArrayList<T>,
    start: Int,
    end: Int,
    compare: (T, T) -> Ordering
): Unit {
    let mut root = start;
    loop {
        let mut child = root * 2 + 1;
        if (child >= end) return;
        if (child + 1 < end) {
            let left = unwrapSome(values.at(child));
            let right = unwrapSome(values.at(child + 1));
            if (compare(left, right) matches Ordering.LT()) child += 1;
        }

        let rootValue = unwrapSome(values.at(root));
        let childValue = unwrapSome(values.at(child));
        if (not (compare(rootValue, childValue) matches Ordering.LT())) return;

        swapArrayList(values, root, child);
        root = child;
    }
}

fn swapArrayList<T admits mutable>(values: &ArrayList<T>, left: Int, right: Int): Unit {
    let leftValue = unwrapSome(values.at(left));
    let rightValue = unwrapSome(values.at(right));
    values.replaceAt(left, rightValue);
    values.replaceAt(right, leftValue);
}

fn sortedArrayList<T admits mutable>(values: ArrayList<T>, compare: (T, T) -> Ordering): ArrayList<T> {
    let mut buffer = ArrayList<T>.empty();
    for (let value in values) buffer.add(value);
    sortArrayList(buffer, compare);
    return buffer;
}

/// Copies the values of an `Iterable` into a new `ArrayList`.
fn arrayListOf<T admits mutable>(values: Iterable<T>): ArrayList<T> {
    let mut result = ArrayList<T>.empty();
    for (let value in values) result.add(value);
    return result;
}
