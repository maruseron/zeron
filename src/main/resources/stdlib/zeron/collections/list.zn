package zeron.collections;

import zeron.lang.Option;
import zeron.lang.Some;
import zeron.lang.None;

// These private self-calls are compiler intrinsics lowered to direct array operations.
fn allocateArray<T>(size: Int): &Array<T> = allocateArray<T>(size);

fn clearArraySlot<T>(values: &Array<T>, index: Int): Unit =
    clearArraySlot<T>(values, index);

class ListIterator<T> is Iterator<T> {
    values: List<T>;
    position: Int;

    private constructor new;

    public constructor from(values: List<T>) = ListIterator<T>.new(values, 0);

    public mut next(): Option<T> {
        if (this.position >= this.values.size) return None<T>.none();
        let value = this.values.at(this.position);
        this.position = this.position + 1;
        return Some<T>.from(value);
    }
}

public class List<T> is Iterable<T> {
    values: &Array<T>;
    count: Int;

    private constructor new;

    public constructor of() = List<T>.empty();

    public constructor of(elements: T...) = List<T>.fromArray(elements);

    public constructor empty() = List<T>.new(allocateArray<T>(4), 0);

    public constructor fromArray(source: Array<T>) {
        let result = List<T>.empty();
        let mut index = 0;
        while (index < source.length) {
            result.add(source[index]);
            index = index + 1;
        }
        return result;
    }

    private mut ensureCapacity(required: Int): Unit {
        if (required > this.values.length) {
            let mut capacity = this.values.length * 2;
            if (capacity < required) capacity = required;
            let mut expanded = allocateArray<T>(capacity);
            let mut index = 0;
            while (index < this.count) {
                expanded[index] = this.values[index];
                index = index + 1;
            }
            this.values = expanded;
        }
    }

    private checkIndex(index: Int): Unit {
        if (index < 0 or index >= this.count) {
            this.values[this.values.length];
        }
    }

    public property size: Int {
        get = this.count;
    }

    public isEmpty(): Boolean = this.count == 0;

    public at(index: Int): T {
        this.checkIndex(index);
        return this.values[index];
    }

    public mut replaceAt(index: Int, value: T): T {
        this.checkIndex(index);
        let previous = this.at(index);
        this.values[index] = value;
        return previous;
    }

    public mut add(value: T): Unit {
        this.ensureCapacity(this.count + 1);
        this.values[this.count] = value;
        this.count = this.count + 1;
    }

    public mut insert(index: Int, value: T): Unit {
        if (index < 0 or index > this.count) {
            this.values[this.values.length];
        }
        this.ensureCapacity(this.count + 1);
        let mut cursor = this.count;
        while (cursor > index) {
            this.values[cursor] = this.values[cursor - 1];
            cursor = cursor - 1;
        }
        this.values[index] = value;
        this.count = this.count + 1;
    }

    public mut removeAt(index: Int): T {
        this.checkIndex(index);
        let removed = this.at(index);
        let mut cursor = index;
        while (cursor + 1 < this.count) {
            this.values[cursor] = this.values[cursor + 1];
            cursor = cursor + 1;
        }
        this.count = this.count - 1;
        clearArraySlot<T>(this.values, this.count);
        return removed;
    }

    public mut clear(): Unit {
        let mut index = 0;
        while (index < this.count) {
            clearArraySlot<T>(this.values, index);
            index = index + 1;
        }
        this.count = 0;
    }

    public iterator(): &Iterator<T> = ListIterator<T>.from(this);
}
