package zeron.collections;

import zeron.lang.Option;
import zeron.lang.Pair;

/// An associative collection with at most one entry per key-equivalence class.
///
/// `get` and `containsKey` use the implementation's key equivalence, and inserting an equivalent
/// key updates the existing entry. Iteration yields one `Pair` per mapping, in order only when an
/// implementation documents one. `K` is intentionally unbound: each implementation states its own
/// key requirement.
public contract Map<K, V: mut> requires Iterable<Pair<K, V>> {
    /// Whether the map holds an entry for `key`.
    containsKey(key: K): Boolean;

    /// Returns the value stored for `key`, or `None` when the key is absent.
    get(key: K): Option<V>;

    /// Returns an iterator over the keys, in unspecified order.
    keyIterator(): &Iterator<K>;
}
