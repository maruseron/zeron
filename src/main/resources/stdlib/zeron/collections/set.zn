package zeron.collections;

import zeron.lang.Hashable;

/// A collection of distinct values with membership tests.
///
/// Membership and insertion use the same equivalence relation, so a set never holds two equivalent
/// elements. The contract does not prescribe how equivalence is implemented: a hash set uses
/// `Hashable`, an identity set reference identity, and an ordered set its ordering. Iteration order
/// is not specified.
public contract Set<T: mut> requires Iterable<T> {
    /// Whether `value` is an element of the set.
    contains(value: T): Boolean;
}
