package zeron.collections;

import zeron.control.Foldable;
import zeron.control.Monad;

class ArrayStream<T: mut> is Iterable<T> {
    values: Array<T>;

    public iterator(): &Iterator<T> {
        let array = values;
        return object: Iterator<T> {
            values: Array<T> = array;
            current: Int = 0;

            public mut next(): Step<T> {
                if (this.current >= this.values.length) return Step<T>.Done();
                let value = this.values[this.current];
                this.current = this.current + 1;
                return Step.Yield(value);
            }
        };
    }
}

class MappedStream<T: mut, R: mut> is Iterable<R> {
    source: Iterable<T>;
    transform: (T) -> R;

    public iterator(): &Iterator<R> {
        let upstream = source.iterator();
        let mapper = transform;
        return object: Iterator<R> {
            source: &Iterator<T> = upstream;
            transform: (T) -> R = mapper;

            public mut next(): Step<R> {
                return match (this.source.next()) {
                    case Step.Yield(value) -> Step.Yield(this.transform(value));
                    case Step.Done() -> Step<R>.Done();
                };
            }
        };
    }
}

class FlatMappedStream<T: mut, R: mut> is Iterable<R> {
    source: Iterable<T>;
    transform: (T) -> Iterable<R>;

    public iterator(): &Iterator<R> {
        let upstream = source.iterator();
        let flatMapper = transform;
        let initialInner = Stream<R>.fromArray([]).iterator();
        return object: Iterator<R> {
            source: &Iterator<T> = upstream;
            transform: (T) -> Iterable<R> = flatMapper;
            inner: &Iterator<R> = initialInner;

            public mut next(): Step<R> {
                let mut item = this.inner.next();
                loop {
                    if (item matches Step.Yield(_)) return item;
                    let outerItem = this.source.next();
                    if (outerItem matches Step.Yield(value)) {
                        this.inner = this.transform(value).iterator();
                    } else {
                        return Step<R>.Done();
                    }
                    item = this.inner.next();
                }
                return Step<R>.Done();
            }
        };
    }
}

class MonadFlatMappedStream<T: mut, R: mut> is Iterable<R> {
    source: Iterable<T>;
    transform: (T) -> Stream<R>;

    public iterator(): &Iterator<R> {
        let upstream = source.iterator();
        let flatMapper = transform;
        let initialInner = Stream<R>.fromArray([]).iterator();
        return object: Iterator<R> {
            source: &Iterator<T> = upstream;
            transform: (T) -> Stream<R> = flatMapper;
            inner: &Iterator<R> = initialInner;

            public mut next(): Step<R> {
                let mut item = this.inner.next();
                loop {
                    if (item matches Step.Yield(_)) return item;
                    let outerItem = this.source.next();
                    if (outerItem matches Step.Yield(value)) {
                        this.inner = this.transform(value).iterator();
                    } else {
                        return Step<R>.Done();
                    }
                    item = this.inner.next();
                }
                return Step<R>.Done();
            }
        };
    }
}

class AppliedStream<A: mut, B: mut> is Iterable<B> {
    values: Iterable<A>;
    functions: Iterable<(A) -> B>;

    public iterator(): &Iterator<B> {
        let functionSource = functions.iterator();
        let valueSource = values;
        let initialValues = Stream<B>.fromArray([]).iterator();
        return object: Iterator<B> {
            functions: &Iterator<(A) -> B> = functionSource;
            values: Iterable<A> = valueSource;
            currentValues: &Iterator<B> = initialValues;

            public mut next(): Step<B> {
                let mut value = this.currentValues.next();
                loop {
                    if (value matches Step.Yield(_)) return value;
                    let function = this.functions.next();
                    if (function matches Step.Yield(transform)) {
                        this.currentValues =
                            MappedStream<A, B>.new(this.values, transform).iterator();
                    } else {
                        return Step<B>.Done();
                    }
                    value = this.currentValues.next();
                }
                return Step<B>.Done();
            }
        };
    }
}

class FilteredStream<T: mut> is Iterable<T> {
    source: Iterable<T>;
    predicate: (T) -> Boolean;

    public iterator(): &Iterator<T> {
        let upstream = source.iterator();
        let test = predicate;
        return object: Iterator<T> {
            source: &Iterator<T> = upstream;
            predicate: (T) -> Boolean = test;

            public mut next(): Step<T> {
                let mut item = this.source.next();
                loop {
                    if (item matches Step.Yield(value)) {
                        if (this.predicate(value)) return item;
                    } else {
                        return Step<T>.Done();
                    }
                    item = this.source.next();
                }
                return Step<T>.Done();
            }
        };
    }
}

class TakenStream<T: mut> is Iterable<T> {
    source: Iterable<T>;
    count: Int;

    public iterator(): &Iterator<T> {
        let upstream = source.iterator();
        let limit = count;
        return object: Iterator<T> {
            source: &Iterator<T> = upstream;
            remaining: Int = limit;

            public mut next(): Step<T> {
                if (this.remaining <= 0) return Step<T>.Done();
                this.remaining = this.remaining - 1;
                return this.source.next();
            }
        };
    }
}

class DroppedStream<T: mut> is Iterable<T> {
    source: Iterable<T>;
    count: Int;

    public iterator(): &Iterator<T> {
        let upstream = source.iterator();
        let dropCount = count;
        return object: Iterator<T> {
            source: &Iterator<T> = upstream;
            count: Int = dropCount;
            initialized: Boolean = false;

            public mut next(): Step<T> {
                if (not this.initialized) {
                    let mut skipped = 0;
                    while (skipped < this.count) {
                        let item = this.source.next();
                        if (item matches Step.Done()) {
                            this.initialized = true;
                            return item;
                        }
                        skipped += 1;
                    }
                    this.initialized = true;
                }
                return this.source.next();
            }
        };
    }
}

class DroppedWhileStream<T: mut> is Iterable<T> {
    source: Iterable<T>;
    predicate: (T) -> Boolean;

    public iterator(): &Iterator<T> {
        let upstream = source.iterator();
        let test = predicate;
        return object: Iterator<T> {
            source: &Iterator<T> = upstream;
            predicate: (T) -> Boolean = test;
            dropping: Boolean = true;

            public mut next(): Step<T> {
                while (this.dropping) {
                    let item = this.source.next();
                    if (item matches Step.Yield(value)) {
                        if (not this.predicate(value)) {
                            this.dropping = false;
                            return item;
                        }
                    } else {
                        return item;
                    }
                }
                return this.source.next();
            }
        };
    }
}

class TakenWhileStream<T: mut> is Iterable<T> {
    source: Iterable<T>;
    predicate: (T) -> Boolean;

    public iterator(): &Iterator<T> {
        let upstream = source.iterator();
        let test = predicate;
        return object: Iterator<T> {
            source: &Iterator<T> = upstream;
            predicate: (T) -> Boolean = test;
            done: Boolean = false;

            public mut next(): Step<T> {
                if (this.done) return Step<T>.Done();
                let item = this.source.next();
                if (item matches Step.Yield(value)) {
                    if (this.predicate(value)) {
                        return item;
                    } else {
                        this.done = true;
                        return Step<T>.Done();
                    }
                } else {
                    this.done = true;
                    return Step<T>.Done();
                }
                return Step<T>.Done();
            }
        };
    }
}

fn streamMonadAp<A: mut, B: mut>(values: Stream<A>, functions: Stream<(A) -> B>): Stream<B> =
    Stream<B>.from(AppliedStream<A, B>.new(values, functions));

public class Stream<T: mut> is Iterable<T>, Monad<Stream<_>>, Foldable<Stream<_>> {
    source: Iterable<T>;

    private constructor new;

    public constructor of(elements: T...) = Stream<T>.fromArray(elements);

    public constructor from(source: Iterable<T>) = Stream<T>.new(source);

    public constructor fromArray(source: Array<T>) =
        Stream<T>.from(ArrayStream<T>.new(source));

    public iterator(): &Iterator<T> = source.iterator();

    public map<R: mut>(transform: (T) -> R): Stream<R> =
        Stream<R>.new(MappedStream<T, R>.new(source, transform));

    public flatMap<R: mut>(transform: (T) -> Iterable<R>): Stream<R> =
        Stream<R>.new(FlatMappedStream<T, R>.new(source, transform));

    public filter(predicate: (T) -> Boolean): Stream<T> =
        Stream<T>.new(FilteredStream<T>.new(source, predicate));

    public fold<R: mut>(initial: R, accumulator: (R, T) -> R): R {
        let mut result = initial;
        for (let item in this) result = accumulator(result, item);
        return result;
    }

    public drop(count: Int): Stream<T> =
        Stream<T>.new(DroppedStream<T>.new(source, count));

    public take(count: Int): Stream<T> =
        Stream<T>.new(TakenStream<T>.new(source, count));

    public dropWhile(predicate: (T) -> Boolean): Stream<T> =
        Stream<T>.new(DroppedWhileStream<T>.new(source, predicate));

    public takeWhile(predicate: (T) -> Boolean): Stream<T> =
        Stream<T>.new(TakenWhileStream<T>.new(source, predicate));

    public count(): Int = fold(0, (a, _) -> a + 1);

    public any(predicate: (T) -> Boolean): Boolean {
        for (let item in this) if (predicate(item)) return true;
        return false;
    }

    public all(predicate: (T) -> Boolean): Boolean {
        for (let item in this) if (not predicate(item)) return false;
        return true;
    }

    delegating implementation Monad<Stream<_>> {
        fn pure<A: mut>(value: A): Stream<A> = Stream<A>.of(value);

        fn flatMap<A: mut, B: mut>(this: Stream<A>, transform: (A) -> Stream<B>): Stream<B> =
            Stream<B>.new(MonadFlatMappedStream<A, B>.new(this.source, transform));

        fn ap<A: mut, B: mut>(this: Stream<A>, functions: Stream<(A) -> B>): Stream<B> =
            streamMonadAp(this, functions);
    }

    delegating implementation Foldable<Stream<_>> {
        fn foldLeft<A: mut, B: mut>(this: Stream<A>, initial: B, combine: (B, A) -> B): B =
            this.fold(initial, combine);
    }

    public toList(): List<T> {
        let mut result = List<T>.empty();
        for (let item in this) result.add(item);
        return result;
    }
}
