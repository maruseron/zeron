package zeron.collections;

import zeron.control.Foldable;
import zeron.control.Monad;
import zeron.lang.Option;
import zeron.internal.unwrapSome;

class ArrayStream<T> is Iterable<T> {
    values: Array<T>;

    public iterator(): &Iterator<T> {
        let array = values;
        return object : Iterator<T> {
            values: Array<T> = array;
            current: Int = 0;

            public mut next(): Option<T> {
                if (this.current >= this.values.length) return Option<T>.None();
                let value = this.values[this.current];
                this.current = this.current + 1;
                return Option.Some(value);
            }
        };
    }
}

class MappedStream<T, R> is Iterable<R> {
    source: Iterable<T>;
    transform: (T) -> R;

    public iterator(): &Iterator<R> {
        let upstream = source.iterator();
        let mapper = transform;
        return object : Iterator<R> {
            source: &Iterator<T> = upstream;
            transform: (T) -> R = mapper;

            public mut next(): Option<R> {
                let item = this.source.next();
                if (not item.isSome()) return Option<R>.None();
                return Option.Some(this.transform(unwrapSome(item)));
            }
        };
    }
}

class FlatMappedStream<T, R> is Iterable<R> {
    source: Iterable<T>;
    transform: (T) -> Iterable<R>;

    public iterator(): &Iterator<R> {
        let upstream = source.iterator();
        let flatMapper = transform;
        let initialInner = Stream<R>.fromArray([]).iterator();
        return object : Iterator<R> {
            source: &Iterator<T> = upstream;
            transform: (T) -> Iterable<R> = flatMapper;
            inner: &Iterator<R> = initialInner;

            public mut next(): Option<R> {
                let mut item = this.inner.next();
                while (true) {
                    if (item.isSome()) return item;
                    let outerItem = this.source.next();
                    if (not outerItem.isSome()) return Option<R>.None();
                    this.inner = this.transform(unwrapSome(outerItem)).iterator();
                    item = this.inner.next();
                }
                return Option<R>.None();
            }
        };
    }
}

class MonadFlatMappedStream<T, R> is Iterable<R> {
    source: Iterable<T>;
    transform: (T) -> Stream<R>;

    public iterator(): &Iterator<R> {
        let upstream = source.iterator();
        let flatMapper = transform;
        let initialInner = Stream<R>.fromArray([]).iterator();
        return object : Iterator<R> {
            source: &Iterator<T> = upstream;
            transform: (T) -> Stream<R> = flatMapper;
            inner: &Iterator<R> = initialInner;

            public mut next(): Option<R> {
                let mut item = this.inner.next();
                while (true) {
                    if (item.isSome()) return item;
                    let outerItem = this.source.next();
                    if (not outerItem.isSome()) return Option<R>.None();
                    this.inner = this.transform(unwrapSome(outerItem)).iterator();
                    item = this.inner.next();
                }
                return Option<R>.None();
            }
        };
    }
}

class AppliedStream<A, B> is Iterable<B> {
    functions: Iterable<(A) -> B>;
    values: Iterable<A>;

    public iterator(): &Iterator<B> {
        let functionSource = functions.iterator();
        let valueSource = values;
        let initialValues = Stream<B>.fromArray([]).iterator();
        return object : Iterator<B> {
            functions: &Iterator<(A) -> B> = functionSource;
            values: Iterable<A> = valueSource;
            currentValues: &Iterator<B> = initialValues;

            public mut next(): Option<B> {
                let mut value = this.currentValues.next();
                while (true) {
                    if (value.isSome()) return value;
                    let function = this.functions.next();
                    if (not function.isSome()) return Option<B>.None();
                    this.currentValues = MappedStream<A, B>.new(
                            this.values, unwrapSome(function)).iterator();
                    value = this.currentValues.next();
                }
                return Option<B>.None();
            }
        };
    }
}

class FilteredStream<T> is Iterable<T> {
    source: Iterable<T>;
    predicate: (T) -> Boolean;

    public iterator(): &Iterator<T> {
        let upstream = source.iterator();
        let test = predicate;
        return object : Iterator<T> {
            source: &Iterator<T> = upstream;
            predicate: (T) -> Boolean = test;

            public mut next(): Option<T> {
                let mut item = this.source.next();
                while (item.isSome()) {
                    if (this.predicate(unwrapSome(item))) return item;
                    item = this.source.next();
                }
                return Option<T>.None();
            }
        };
    }
}

class TakenStream<T> is Iterable<T> {
    source: Iterable<T>;
    count: Int;

    public iterator(): &Iterator<T> {
        let upstream = source.iterator();
        let limit = count;
        return object : Iterator<T> {
            source: &Iterator<T> = upstream;
            remaining: Int = limit;

            public mut next(): Option<T> {
                if (this.remaining <= 0) return Option<T>.None();
                this.remaining = this.remaining - 1;
                return this.source.next();
            }
        };
    }
}

class DroppedStream<T> is Iterable<T> {
    source: Iterable<T>;
    count: Int;

    public iterator(): &Iterator<T> {
        let upstream = source.iterator();
        let dropCount = count;
        return object : Iterator<T> {
            source: &Iterator<T> = upstream;
            count: Int = dropCount;
            initialized: Boolean = false;

            public mut next(): Option<T> {
                if (not this.initialized) {
                    let mut skipped = 0;
                    while (skipped < this.count) {
                        let item = this.source.next();
                        if (not item.isSome()) {
                            this.initialized = true;
                            return item;
                        }
                        skipped += 1;
                    }
                    this.initialized = true;
                }
                return this.source.next();
            }
        };
    }
}

class DroppedWhileStream<T> is Iterable<T> {
    source: Iterable<T>;
    predicate: (T) -> Boolean;

    public iterator(): &Iterator<T> {
        let upstream = source.iterator();
        let test = predicate;
        return object : Iterator<T> {
            source: &Iterator<T> = upstream;
            predicate: (T) -> Boolean = test;
            dropping: Boolean = true;

            public mut next(): Option<T> {
                while (this.dropping) {
                    let item = this.source.next();
                    if (not item.isSome()) return item;

                    if (not this.predicate(unwrapSome(item))) {
                        this.dropping = false;
                        return item;
                    }
                }
                return this.source.next();
            }
        };
    }
}

class TakenWhileStream<T> is Iterable<T> {
    source: Iterable<T>;
    predicate: (T) -> Boolean;

    public iterator(): &Iterator<T> {
        let upstream = source.iterator();
        let test = predicate;
        return object : Iterator<T> {
            source: &Iterator<T> = upstream;
            predicate: (T) -> Boolean = test;
            done: Boolean = false;

            public mut next(): Option<T> {
                if (this.done) return Option<T>.None();

                let item = this.source.next();
                if (not item.isSome()) {
                    this.done = true;
                    return Option<T>.None();
                }

                if (this.predicate(unwrapSome(item))) {
                    return item;
                } else {
                    this.done = true;
                    return Option<T>.None();
                }
            }
        };
    }
}

fn streamMonadAp<A, B>(
    functions: Stream<(A) -> B>,
    values: Stream<A>
): Stream<B> = Stream<B>.from(AppliedStream<A, B>.new(functions, values));

fn streamMonadFlatMap<A, B>(
    source: Stream<A>,
    transform: (A) -> Stream<B>
): Stream<B> = Stream<B>.from(MonadFlatMappedStream<A, B>.new(source, transform));

public class Stream<T> is Iterable<T>, Monad<Stream<_>>, Foldable<Stream<_>> {
    source: Iterable<T>;

    private constructor new;

    public constructor of(elements: T...) = 
        Stream<T>.fromArray(elements);

    public constructor from(source: Iterable<T>) = 
        Stream<T>.new(source);

    public constructor fromArray(source: Array<T>) =
        Stream<T>.from(ArrayStream<T>.new(source));

    public iterator(): &Iterator<T> = source.iterator();

    implementation Monad<Stream<_>> {
        fn map<A, B>(this: Stream<A>, transform: (A) -> B): Stream<B> =
            this.map(transform);

        fn pure<A>(value: A): Stream<A> = Stream<A>.of(value);

        fn ap<A, B>(this: Stream<(A) -> B>, values: Stream<A>): Stream<B> =
            streamMonadAp(this, values);

        fn flatMap<A, B>(this: Stream<A>, transform: (A) -> Stream<B>): Stream<B> =
            streamMonadFlatMap(this, transform);
    }

    implementation Foldable<Stream<_>> {
        fn foldLeft<A, B>(this: Stream<A>, initial: B, combine: (B, A) -> B): B =
            this.fold(initial, combine);
    }

    public map<R>(transform: (T) -> R): Stream<R> =
        Stream<R>.new(MappedStream<T, R>.new(source, transform));

    public flatMap<R>(transform: (T) -> Iterable<R>): Stream<R> =
        Stream<R>.new(FlatMappedStream<T, R>.new(source, transform));

    public filter(predicate: (T) -> Boolean): Stream<T> =
        Stream<T>.new(FilteredStream<T>.new(source, predicate));

    public fold<R>(initial: R, accumulator: (R, T) -> R): R {
        let mut result = initial;
        for (let item in this) result = accumulator(result, item);
        return result;
    }

    public drop(count: Int): Stream<T> =
        Stream<T>.new(DroppedStream<T>.new(source, count));

    public take(count: Int): Stream<T> =
        Stream<T>.new(TakenStream<T>.new(source, count));

    public dropWhile(predicate: (T) -> Boolean): Stream<T> =
        Stream<T>.new(DroppedWhileStream<T>.new(source, predicate));

    public takeWhile(predicate: (T) -> Boolean): Stream<T> =
        Stream<T>.new(TakenWhileStream<T>.new(source, predicate));

    public count(): Int =
        fold(0, (a, _) -> a + 1);

    public any(predicate: (T) -> Boolean): Boolean {
        for (let item in this) if (predicate(item)) return true;
        return false;
    }

    public all(predicate: (T) -> Boolean): Boolean {
        for (let item in this) if (not predicate(item)) return false;
        return true;
    }

    public toList(): List<T> {
        let mut result = List<T>.empty();
        for (let item in this) result.add(item);
        return result;
    }
}
