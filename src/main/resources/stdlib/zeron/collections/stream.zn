package zeron.collections;

import zeron.control.Foldable;
import zeron.internal.unwrapSome;
import zeron.control.Functor;
import zeron.control.Applicative;
import zeron.control.Monad;

class ArrayStream<T admits mutable> is Iterable<T> {
    values: Array<T>;

    public iterator(): &Iterator<T> {
        return object: Iterator<T> {
            values: Array<T> = values;
            current: Int = 0;

            public mut next(): Step<T> {
                if (this.current >= this.values.length) return Step<T>.Done();
                let value = this.values[this.current];
                this.current = this.current + 1;
                return Step.Yield(value);
            }
        };
    }
}

class ConcatStream<T admits mutable> is Iterable<T> {
    left: Iterable<T>;
    right: Iterable<T>;

    public iterator(): &Iterator<T> {
        let l = left.iterator();
        let r = right.iterator();
        return object: Iterator<T> {
            current: &Iterator<T> = l;

            private mut extractNext(): Step<T> {
                if (this.current === l) {
                    this.current = r;
                    return this.current.next();
                }

                return Step.Done();
            }

            public mut next(): Step<T> =
                match (this.current.next()) {
                    case Yield(value) -> Yield(value);
                    case Done() -> extractNext();
                };
        };
    }
}

class MappedStream<T admits mutable, R admits mutable> is Iterable<R> {
    source: Iterable<T>;
    transform: (T) -> R;

    public iterator(): &Iterator<R> {
        let upstream = source.iterator();
        let mapper = transform;
        return object: Iterator<R> {
            source: &Iterator<T> = upstream;
            transform: (T) -> R = mapper;

            public mut next(): Step<R> {
                return match (this.source.next()) {
                    case Step.Yield(value) -> Step.Yield(this.transform(value));
                    case Step.Done() -> Step<R>.Done();
                };
            }
        };
    }
}

class FlatMappedStream<T admits mutable, R admits mutable> is Iterable<R> {
    source: Iterable<T>;
    transform: (T) -> Iterable<R>;

    public iterator(): &Iterator<R> {
        let upstream = source.iterator();
        let flatMapper = transform;
        let initialInner = Stream<R>.fromArray([]).iterator();
        return object: Iterator<R> {
            source: &Iterator<T> = upstream;
            transform: (T) -> Iterable<R> = flatMapper;
            inner: &Iterator<R> = initialInner;

            public mut next(): Step<R> {
                let mut item = this.inner.next();
                loop {
                    if (item matches Step.Yield(_)) return item;
                    let outerItem = this.source.next();
                    if (outerItem matches Step.Yield(value)) {
                        this.inner = this.transform(value).iterator();
                    } else {
                        return Step<R>.Done();
                    }
                    item = this.inner.next();
                }
                return Step<R>.Done();
            }
        };
    }
}

class MonadFlatMappedStream<T admits mutable, R admits mutable> is Iterable<R> {
    source: Iterable<T>;
    transform: (T) -> Stream<R>;

    public iterator(): &Iterator<R> {
        let upstream = source.iterator();
        let flatMapper = transform;
        let initialInner = Stream<R>.fromArray([]).iterator();
        return object: Iterator<R> {
            source: &Iterator<T> = upstream;
            transform: (T) -> Stream<R> = flatMapper;
            inner: &Iterator<R> = initialInner;

            public mut next(): Step<R> {
                let mut item = this.inner.next();
                loop {
                    if (item matches Step.Yield(_)) return item;
                    let outerItem = this.source.next();
                    if (outerItem matches Step.Yield(value)) {
                        this.inner = this.transform(value).iterator();
                    } else {
                        return Step<R>.Done();
                    }
                    item = this.inner.next();
                }
                return Step<R>.Done();
            }
        };
    }
}

class AppliedStream<A admits mutable, B admits mutable> is Iterable<B> {
    values: Iterable<A>;
    functions: Iterable<(A) -> B>;

    public iterator(): &Iterator<B> {
        let functionSource = functions.iterator();
        let valueSource = values;
        let initialValues = Stream<B>.fromArray([]).iterator();
        return object: Iterator<B> {
            functions: &Iterator<(A) -> B> = functionSource;
            values: Iterable<A> = valueSource;
            currentValues: &Iterator<B> = initialValues;

            public mut next(): Step<B> {
                let mut value = this.currentValues.next();
                loop {
                    if (value matches Step.Yield(_)) return value;
                    let function = this.functions.next();
                    if (function matches Step.Yield(transform)) {
                        this.currentValues =
                            MappedStream<A, B>.new(this.values, transform).iterator();
                    } else {
                        return Step<B>.Done();
                    }
                    value = this.currentValues.next();
                }
                return Step<B>.Done();
            }
        };
    }
}

class FilteredStream<T admits mutable> is Iterable<T> {
    source: Iterable<T>;
    predicate: (T) -> Boolean;

    public iterator(): &Iterator<T> {
        let upstream = source.iterator();
        let test = predicate;
        return object: Iterator<T> {
            source: &Iterator<T> = upstream;
            predicate: (T) -> Boolean = test;

            public mut next(): Step<T> {
                let mut item = this.source.next();
                loop {
                    if (item matches Step.Yield(value)) {
                        if (this.predicate(value)) return item;
                    } else {
                        return Step<T>.Done();
                    }
                    item = this.source.next();
                }
                return Step<T>.Done();
            }
        };
    }
}

class TakenStream<T admits mutable> is Iterable<T> {
    source: Iterable<T>;
    count: Int;

    public iterator(): &Iterator<T> {
        let upstream = source.iterator();
        let limit = count;
        return object: Iterator<T> {
            source: &Iterator<T> = upstream;
            remaining: Int = limit;

            public mut next(): Step<T> {
                if (this.remaining <= 0) return Step<T>.Done();
                this.remaining = this.remaining - 1;
                return this.source.next();
            }
        };
    }
}

class DroppedStream<T admits mutable> is Iterable<T> {
    source: Iterable<T>;
    count: Int;

    public iterator(): &Iterator<T> {
        let upstream = source.iterator();
        let dropCount = count;
        return object: Iterator<T> {
            source: &Iterator<T> = upstream;
            count: Int = dropCount;
            initialized: Boolean = false;

            public mut next(): Step<T> {
                if (not this.initialized) {
                    let mut skipped = 0;
                    while (skipped < this.count) {
                        let item = this.source.next();
                        if (item matches Step.Done()) {
                            this.initialized = true;
                            return item;
                        }
                        skipped += 1;
                    }
                    this.initialized = true;
                }
                return this.source.next();
            }
        };
    }
}

class DroppedWhileStream<T admits mutable> is Iterable<T> {
    source: Iterable<T>;
    predicate: (T) -> Boolean;

    public iterator(): &Iterator<T> {
        let upstream = source.iterator();
        let test = predicate;
        return object: Iterator<T> {
            source: &Iterator<T> = upstream;
            predicate: (T) -> Boolean = test;
            dropping: Boolean = true;

            public mut next(): Step<T> {
                while (this.dropping) {
                    let item = this.source.next();
                    if (item matches Step.Yield(value)) {
                        if (not this.predicate(value)) {
                            this.dropping = false;
                            return item;
                        }
                    } else {
                        return item;
                    }
                }
                return this.source.next();
            }
        };
    }
}

class TakenWhileStream<T admits mutable> is Iterable<T> {
    source: Iterable<T>;
    predicate: (T) -> Boolean;

    public iterator(): &Iterator<T> {
        let upstream = source.iterator();
        let test = predicate;
        return object: Iterator<T> {
            source: &Iterator<T> = upstream;
            predicate: (T) -> Boolean = test;
            done: Boolean = false;

            public mut next(): Step<T> {
                if (this.done) return Step<T>.Done();
                let item = this.source.next();
                if (item matches Step.Yield(value)) {
                    if (this.predicate(value)) {
                        return item;
                    } else {
                        this.done = true;
                        return Step<T>.Done();
                    }
                } else {
                    this.done = true;
                    return Step<T>.Done();
                }
                return Step<T>.Done();
            }
        };
    }
}

class SortedByStream<T admits mutable> is Iterable<T> {
    source: Iterable<T>;
    compare: (T, T) -> Ordering;

    public iterator(): &Iterator<T> {
        let upstream = source.iterator();
        let comparator = compare;
        return object: Iterator<T> {
            source: &Iterator<T> = upstream;
            compare: (T, T) -> Ordering = comparator;
            values: ArrayList<T> = ArrayList<T>.empty();
            position: Int = 0;
            sorted: Boolean = false;

            public mut next(): Step<T> {
                if (not this.sorted) {
                    let mut buffer = ArrayList<T>.empty();
                    let mut item = this.source.next();
                    while (item matches Step.Yield(value)) {
                        buffer.add(value);
                        item = this.source.next();
                    }
                    sortArrayList(buffer, this.compare);
                    this.values = buffer;
                    this.sorted = true;
                }

                if (this.position >= this.values.size) return Step<T>.Done();
                let value = unwrapSome(this.values.at(this.position));
                this.position = this.position + 1;
                return Step.Yield(value);
            }
        };
    }
}

fn streamMonadAp<A admits mutable, B admits mutable>(values: Stream<A>, functions: Stream<(A) -> B>): Stream<B> =
    Stream<B>.from(AppliedStream<A, B>.new(values, functions));

/// A lazily evaluated sequence of values.
///
/// A stream is a view over an `Iterable`: transformations such as `map` and `filter` build a new
/// view and do no work until an iterator is pulled. Each traversal starts a fresh iterator from the
/// underlying source, so a stream can be traversed again whenever its source can; results are not
/// cached, and a transformation's function may run once per traversal.
///
/// The terminal operations `fold`, `collect`, `collectWith`, `count`, `any`, `all`, and `toList`
/// consume the traversal they start, and `any`/`all` stop at the first decisive element.
public class Stream<T admits mutable>
    is Iterable<T>, 
       Functor<Stream<_>>, 
       Applicative<Stream<_>>,
       Monad<Stream<_>>, 
       Foldable<Stream<_>> {
    source: Iterable<T>;

    private constructor new;

    /// Returns a stream over the given elements.
    public constructor of(elements: T...) = Stream<T>.fromArray(elements);

    /// Returns a stream over the elements of `source`.
    public constructor from(source: Iterable<T>) = Stream<T>.new(source);

    /// Returns a stream over the elements of `source`, in index order.
    public constructor fromArray(source: Array<T>) =
        Stream<T>.from(ArrayStream<T>.new(source));

    public constructor concat(fst: Iterable<T>, snd: Iterable<T>) =
        Stream.from(ConcatStream<T>.new(fst, snd));

    /// Returns a new iterator over this stream's elements.
    public iterator(): &Iterator<T> = source.iterator();

    /// Returns a stream of the results of `transform` applied to each element.
    public map<R admits mutable>(transform: (T) -> R): Stream<R> =
        Stream<R>.new(MappedStream<T, R>.new(source, transform));

    /// Returns a stream of the elements of every sequence produced by `transform`.
    public flatMap<R admits mutable>(transform: (T) -> Iterable<R>): Stream<R> =
        Stream<R>.new(FlatMappedStream<T, R>.new(source, transform));

    /// Returns a stream of the elements accepted by `predicate`.
    public filter(predicate: (T) -> Boolean): Stream<T> =
        Stream<T>.new(FilteredStream<T>.new(source, predicate));

    /// Combines the elements from left to right into a single value.
    public fold<R admits mutable, E admits effect...>(
        initial: R,
        accumulator: (R, T) -> R performs E
    ): R performs E {
        let mut result = initial;
        for (let item in this) result = accumulator(result, item);
        return result;
    }

    /// Returns a stream that skips the first `count` elements.
    ///
    /// The elements are skipped when the first element of the result is requested, not when this
    /// method is called. Counts below `0` are treated as `0`.
    public drop(count: Int): Stream<T> =
        Stream<T>.new(DroppedStream<T>.new(source, count));

    /// Returns a stream of at most the first `count` elements.
    ///
    /// Counts below `0` produce an empty stream.
    public take(count: Int): Stream<T> =
        Stream<T>.new(TakenStream<T>.new(source, count));

    /// Returns a stream that skips leading elements accepted by `predicate`.
    public dropWhile(predicate: (T) -> Boolean): Stream<T> =
        Stream<T>.new(DroppedWhileStream<T>.new(source, predicate));

    /// Returns a stream of the leading elements accepted by `predicate`, stopping at the first
    /// rejected element.
    public takeWhile(predicate: (T) -> Boolean): Stream<T> =
        Stream<T>.new(TakenWhileStream<T>.new(source, predicate));

    /// Returns a stream of this stream's elements ordered by `compare`.
    ///
    /// This is a stateful intermediate operation: the first traversal buffers every element, sorts
    /// the buffer, and then yields the elements in order. Later traversals sort the source again,
    /// so the operation costs `O(n)` extra space per traversal. Use `compareTo` for the natural
    /// order of comparable elements.
    public sortedBy(compare: (T, T) -> Ordering): Stream<T> =
        Stream<T>.from(SortedByStream<T>.new(source, compare));

    /// Counts the elements by traversing the stream.
    public count(): Int = fold(0, (a, _) -> a + 1);

    /// Collects the elements through the operations that build a collector.
    ///
    /// `initial` starts the accumulation, `add` combines the accumulator with an element, and
    /// `finish` produces the result. The operations are handed to `Collector.of`, so the same
    /// three arguments can be built once as a collector and passed to `collectWith` instead.
    public collect<R admits mutable, S admits mutable>(initial: S, add: (S, T) -> S, finish: (S) -> R): R =
        this.collectWith(Collector.of<S, T, R>(initial, add, finish));

    /// Adds every element to an already-built `collector` and returns its result.
    ///
    /// `collectWith` is the terminal operation for reusable collection strategies: the collector
    /// decides how items accumulate, and its `finish` produces the value. `StringJoiner`,
    /// `Collector.toArrayList`, and `Collector.summing` are such collectors, so a join, a list
    /// build, or a sum needs no intermediate collection and no per-call folding function.
    public collectWith<R admits mutable>(collector: &Collector<T, R>): R {
        for (let item in this) if (not collector.add(item)) break;
        return collector.finish();
    }

    /// Whether any element is accepted by `predicate`, stopping at the first acceptance.
    public any<E admits effect...>(predicate: (T) -> Boolean performs E): Boolean performs E {
        for (let item in this) if (predicate(item)) return true;
        return false;
    }

    /// Whether every element is accepted by `predicate`, stopping at the first rejection.
    ///
    /// An empty stream satisfies `all` for any predicate.
    public all<E admits effect...>(predicate: (T) -> Boolean performs E): Boolean performs E {
        for (let item in this) if (not predicate(item)) return false;
        return true;
    }

    delegating implementation Functor<Stream<_>> {}

    delegating implementation Applicative<Stream<_>> {
        fn pure<A>(value: A): Stream<A> = Stream<A>.of(value);

        fn ap<A, B>(this: Stream<A>, functions: Stream<(A) -> B>): Stream<B> =
            streamMonadAp(this, functions);
    }

    delegating implementation Monad<Stream<_>> {
        fn flatMap<A, B>(this: Stream<A>, transform: (A) -> Stream<B>): Stream<B> =
            Stream<B>.new(MonadFlatMappedStream<A, B>.new(this.source, transform));
    }

    delegating implementation Foldable<Stream<_>> {
        fn foldLeft<A, B>(this: Stream<A>, initial: B, combine: (B, A) -> B): B =
            this.fold(initial, combine);
    }

    /// Collects every element into a new array-backed list, in traversal order.
    public toList(): ArrayList<T> {
        let mut result = ArrayList<T>.empty();
        for (let item in this) result.add(item);
        return result;
    }
}
