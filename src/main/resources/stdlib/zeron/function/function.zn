package zeron.function;

import zeron.collections.Map;

/// The identity function.
public fn identity<A: mut>(a: A): A = a;

/*

/// Returns a new nullary function that, given a value `c`, will always
/// return `c`.
public fn supply<A: mut>(c: A): () -> A = 
    () -> c;

/// Returns a new function that, given a value `c` and regardless of input, 
/// will always return `c`.
public fn constant<A: mut, B: mut>(c: B): (A) -> B =
    x -> c;

// core combiners 

/// Returns a new function that, given two functions `f` and `g` passes an 
/// argument through `f`, then `g`, so that
/// ```zeron
/// compose(g, f)(x) == g(f(x))
/// ```
/// `pipe` is the inverse of this function.
public fn compose<A: mut, B: mut, C: mut>(g: (B) -> C, f: (A) -> B): (A) -> C =
    x -> g(f(x));

/// Returns a new function that, given two functions `f` and `g` passes an 
/// argument through `f`, then `g`, so that
/// ```zeron
/// pipe(f, g)(x) == g(f(x))
/// ```
/// `compose` is the inverse of this function.
public fn pipe<A: mut, B: mut, C: mut>(f: (A) -> B, g: (B) -> C): (A) -> C =
    x -> g(f(x));

/// Returns a new function that flips the order of the arguments in `f`.
public fn flip<A: mut, B: mut, C: mut>(f: (A, B) -> C): (B, A) -> C =
    (b, a) -> f(a, b);

