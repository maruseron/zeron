/// This operation is short circuiting, and the predicates will be evaluated in order.
public fn either<A: mut>(f: (A) -> Boolean, g: (A) -> Boolean): (A) -> Boolean =
    a -> f(a) or g(a);

*/

/// Returns a new function that wraps a given unary function `f` with a caching mechanism 
/// to store and reuse previously computed results for identical inputs.
/// This operation requires the argument type `A` to satisfy the Hashable contract.
public fn memoize<A: Hashable<A>, B: mut>(f: (A) -> B): (A) -> B {
    let cache = Map.empty<A, B>();
    
    return a -> cache.computeIfAbsent(a, k -> f(k));
}

/// Debugging mixin that enables peeking operations on a container.
/// Purity is not enforced, but mutating this or any object through
/// `Peekable.peek` is heavily discouraged.
public contract Peekable<T<_>> {

    /// Invokes the provided function with `this` as an argument, then returns `this`.
    /// This function only exists for debugging purposes and should generally be
    /// avoided in production code.
    peek<A>(this: T<A>, action: (A) -> Unit): A;
}
