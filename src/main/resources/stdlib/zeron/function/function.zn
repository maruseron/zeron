/// Returns a new function that, given a boolean-valued function `p`,
/// inverts its result.
public fn negate<A: mut>(p: (A) -> Boolean): (A) -> Boolean =
    a -> not p(a);

/// Returns a new function that, given two boolean-valued functions `f` and `g` 
/// and any value `a`, returns `true` when both f(a) and g(a) are true.
/// This operation is short circuiting, and the predicates will be evaluated in order.
public fn both<A: mut>(f: (A) -> Boolean, g: (A) -> Boolean): (A) -> Boolean =
    a -> f(a) and g(a);

/// Returns a new function that, given two boolean-valued functions `f` and `g` 
