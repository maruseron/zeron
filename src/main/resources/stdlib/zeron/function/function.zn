// helper for inference since nested lambdas don't work yet
fn applyFirst<A: mut, B: mut, C: mut>(
    f: (A, B) -> C,
    a: A
): (B) -> C = b -> f(a, b);

public fn curry<A: mut, B: mut, C: mut>(f: (A, B) -> C): (A) -> (B) -> C =
    a -> applyFirst(f, a);

