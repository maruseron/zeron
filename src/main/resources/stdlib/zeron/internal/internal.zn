package zeron.internal;

import zeron.collections.ArrayList;
import zeron.lang.Option;

fn allocateArray<T admits nullable + mutable>(size: Int): &Array<T> = allocateArray<T>(size);

public fn allocateByteArray(size: Int): &ByteArray = allocateByteArray(size);

public fn unwrapSome<T admits nullable + mutable>(option: Option<T>): T = unwrapSome<T>(option);

public fn generateArray<T admits nullable + mutable>(length: Int, initialize: (Int) -> T): &Array<T> {
    let mut values = allocateArray<T>(length);
    let mut index = 0;
    while (index < length) {
        values[index] = initialize(index);
        index += 1;
    }
    return values;
}

/// Copies every element of `values` into a new fixed-size array.
public fn arrayFromList<T admits mutable>(values: &ArrayList<T>): &Array<T> {
    let mut result = allocateArray<T>(values.size);
    let mut index = 0;
    while (index < values.size) {
        result[index] = unwrapSome(values.at(index));
        index += 1;
    }
    return result;
}

public fn arrayToByteArray(values: Array<Byte>): ByteArray {
    let mut bytes = allocateByteArray(values.length);
    let mut index = 0;
    while (index < values.length) {
        bytes[index] = values[index];
        index += 1;
    }
    return bytes;
}

public fn byteArrayToArray(bytes: ByteArray): &Array<Byte> =
    generateArray<Byte>(bytes.length, (index) -> bytes[index]);