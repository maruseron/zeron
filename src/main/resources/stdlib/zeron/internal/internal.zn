package zeron.internal;

import zeron.lang.Option;

fn allocateArray<T: nullable + mut>(size: Int): &Array<T> = allocateArray<T>(size);

public fn allocateByteArray(size: Int): &ByteArray = allocateByteArray(size);

public fn unwrapSome<T: nullable + mut>(option: Option<T>): T = unwrapSome<T>(option);

public fn generateArray<T: nullable + mut>(length: Int, initialize: (Int) -> T): &Array<T> {
    let mut values = allocateArray<T>(length);
    let mut index = 0;
    while (index < length) {
        values[index] = initialize(index);
        index += 1;
    }
    return values;
}

public fn arrayToByteArray(values: Array<Byte>): ByteArray {
    let mut bytes = allocateByteArray(values.length);
    let mut index = 0;
    while (index < values.length) {
        bytes[index] = values[index];
        index += 1;
    }
    return bytes;
}

public fn byteArrayToArray(bytes: ByteArray): &Array<Byte> =
    generateArray<Byte>(bytes.length, (index) -> bytes[index]);