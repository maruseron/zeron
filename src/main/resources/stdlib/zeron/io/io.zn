package zeron.io;

import java.lang.IO;
import java.lang.System;

public fn print(value: Any?): Unit {
    System.out?.print(value);
}

public fn println(value: Any?): Unit {
    System.out?.println(value);
}

public fn readln(): String? {
    return IO.readln();
}

public fn prompt(prompt: String): String? {
    return IO.readln(prompt);
}