package zeron.io;

import java.io.File;
import java.io.InputStream;
import java.io.OutputStream;
import java.nio.file.Files;

import zeron.fs.Path;
import zeron.lang.Option;
import zeron.resource.Disposable;
import zeron.resource.DisposeFailure;

public contract Reader requires Disposable {
    mut read(buffer: &ByteArray, offset: Int, length: Int): Option<Int> performs IoFailure;
}

public contract Writer requires Disposable {
    mut write(buffer: ByteArray, offset: Int, length: Int): Unit performs IoFailure;

    mut flush(): Unit performs IoFailure;
}

class FileByteReader is Reader, Disposable {
    input: &InputStream;

    private constructor new;

    public constructor from(input: &InputStream) = FileByteReader.new(input);

    public mut read(buffer: &ByteArray, offset: Int, length: Int): Option<Int> performs IoFailure {
        let count = this.input.read(buffer, offset, length);
        if (count < 0) return Option<Int>.None();
        return Option.Some(count);
    }

    public mut dispose(): Unit performs DisposeFailure {
        handle (this.input.close()) with {
            case IoFailure.cause(cause) -> perform DisposeFailure.new(cause);
        };
    }
}

class FileByteWriter is Writer, Disposable {
    output: &OutputStream;

    private constructor new;

    public constructor from(output: &OutputStream) = FileByteWriter.new(output);

    public mut write(buffer: ByteArray, offset: Int, length: Int): Unit performs IoFailure {
        this.output.write(buffer, offset, length);
    }

    public mut flush(): Unit performs IoFailure {
        this.output.flush();
    }

    private mut closeAfterFlushFailure(cause: java.io.IOException): Unit performs DisposeFailure {
        handle (this.output.close()) with {
            case IoFailure.cause(closeCause) -> perform DisposeFailure.new(closeCause);
        };
        perform DisposeFailure.new(cause);
    }

    public mut dispose(): Unit performs DisposeFailure {
        handle (this.output.flush()) with {
            case IoFailure.cause(cause) -> this.closeAfterFlushFailure(cause);
        };
        handle (this.output.close()) with {
            case IoFailure.cause(cause) -> perform DisposeFailure.new(cause);
        };
    }
}

public fn openReader(path: Path): &Reader performs IoFailure =
    FileByteReader.from(Files.newInputStream(File.new(path.toString()).toPath()));

public fn openWriter(path: Path): &Writer performs IoFailure =
    FileByteWriter.from(Files.newOutputStream(File.new(path.toString()).toPath()));
