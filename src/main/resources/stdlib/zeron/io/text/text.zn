package zeron.io.text;

import java.io.BufferedWriter;
import java.io.File;
import java.nio.file.Files;
import zeron.fs.Path;
import zeron.io.IoFailure;
import zeron.resource.Disposable;
import zeron.resource.DisposeFailure;

class TextWriter is Disposable {
    writer: &BufferedWriter;

    private constructor new;

    public constructor with(writer: &BufferedWriter) = TextWriter.new(writer);

    public mut write(value: String): Unit raises IoFailure {
        this.writer.write(value, 0, value.length());
    }

    public mut dispose(): Unit raises DisposeFailure {
        handle (this.writer.close()) with {
            case IoFailure.cause(cause) -> raise DisposeFailure.new(cause);
        };
    }
}

public fn readText(path: Path): String raises IoFailure =
    Files.readString(File.new(path.toString()).toPath());

public fn writeText(path: Path, value: String): Unit raises IoFailure, DisposeFailure {
    using (let writer: &TextWriter = TextWriter.with(
            Files.newBufferedWriter(File.new(path.toString()).toPath()))) {
        writer.write(value);
    }
}
