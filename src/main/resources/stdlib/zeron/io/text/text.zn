package zeron.io.text;

import java.io.ByteArrayOutputStream;
import java.io.File;
import java.nio.ByteBuffer;
import java.nio.charset.CodingErrorAction;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;

import zeron.fs.Path;
import zeron.internal.allocateByteArray;
import zeron.io.IoFailure;
import zeron.io.Reader;
import zeron.io.Writer;
import zeron.io.openReader;
import zeron.io.openWriter;
import zeron.resource.Disposable;
import zeron.resource.DisposeFailure;

public class TextWriter is Disposable {
    writer: &Writer;

    private constructor new;

    public constructor with(writer: &Writer) = TextWriter.new(writer);

    public mut write(value: String): Unit raises IoFailure {
        let bytes = stringGetBytes(value, StandardCharsets.UTF_8);
        this.writer.write(bytes, 0, bytes.length);
    }

    public mut flush(): Unit raises IoFailure {
        this.writer.flush();
    }

    public mut dispose(): Unit raises DisposeFailure = this.writer.dispose();
}

public class TextReader is Disposable {
    reader: &Reader;

    private constructor new;

    public constructor with(reader: &Reader) = TextReader.new(reader);

    public mut readAll(): String raises IoFailure {
        let mut buffer: &ByteArray = allocateByteArray(4096);
        let output = ByteArrayOutputStream.new();
        let mut complete = false;
        while (not complete) {
            let chunk = this.reader.read(buffer, 0, buffer.length);
            if (chunk.isSome()) {
                output.write(buffer, 0, chunk.getOrElse(0));
            } else {
                complete = true;
            }
        }
        let decoder = utf8Decoder();
        if (decoder != null) {
            decoder.onMalformedInput(CodingErrorAction.REPORT);
            decoder.onUnmappableCharacter(CodingErrorAction.REPORT);
            return decoder.decode(ByteBuffer.wrap(output.toByteArray())).toString();
        }
        raise IoFailure.new(java.io.IOException.new("UTF-8 charset unavailable"));
    }

    public mut dispose(): Unit raises DisposeFailure = this.reader.dispose();
}

public fn readText(path: Path): String raises IoFailure =
    Files.readString(File.new(path.toString()).toPath());

public fn openTextReader(path: Path): &TextReader raises IoFailure =
    TextReader.with(openReader(path));

public fn openTextWriter(path: Path): &TextWriter raises IoFailure =
    TextWriter.with(openWriter(path));

public fn writeText(path: Path, value: String): Unit raises IoFailure, DisposeFailure {
    using (let writer: &TextWriter = openTextWriter(path)) {
        writer.write(value);
    }
}

external fn stringGetBytes(value: String?, charset: &java.nio.charset.Charset?): ByteArray;

fn utf8Decoder(): &java.nio.charset.CharsetDecoder? = StandardCharsets.UTF_8?.newDecoder();
