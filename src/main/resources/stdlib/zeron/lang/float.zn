package zeron.lang;

import java.lang.Double;
import java.lang.Math;

import zeron.numeric.Integer;
import zeron.numeric.Rational;
import zeron.numeric.Numeric;
import zeron.numeric.Fractional;
import zeron.numeric.Floating;

default witness Numeric<Float> for Float {
    fn add(other: Float): Float = this + other;
    fn subtract(other: Float): Float = this - other;
    fn multiply(other: Float): Float = this * other;
    fn negate(): Float = -this;
    fn abs(): Float = unsafe Math.abs(this);
    fn signum(): Float =
        if (this < 0.0) then -1.0 else if (this > 0.0) then 1.0 else if (this == 0.0) then 0.0 else this;
    static fn fromInteger(value: Integer): Float = value.toFloat();
}

default witness Fractional<Float> for Float {
    fn divide(other: Float): Float = this / other;
    fn reciprocal(): Float = 1.0 / this;
    static fn fromRational(value: Rational): Float = value.toFloat();
}

default witness Floating<Float> for Float {
    fn sqrt(): Float = unsafe Math.sqrt(this);
    fn pow(exponent: Float): Float = unsafe Math.pow(this, exponent);
    fn exp(): Float = unsafe Math.exp(this);
    fn ln(): Float = unsafe Math.log(this);
    fn log10(): Float = unsafe Math.log10(this);
    fn sin(): Float = unsafe Math.sin(this);
    fn cos(): Float = unsafe Math.cos(this);
    fn tan(): Float = unsafe Math.tan(this);
    fn asin(): Float = unsafe Math.asin(this);
    fn acos(): Float = unsafe Math.acos(this);
    fn atan(): Float = unsafe Math.atan(this);
    fn atan2(x: Float): Float = unsafe Math.atan2(this, x);
}

/// Derived properties and conversions of `Float`.
public extension Float {
    /// The sign of this float: `-1`, `0`, or `1`, or `None` when the value is `NaN`.
    ///
    /// Both `0.0` and `-0.0` report `0`.
    public property sign: Option<Int> {
        get {
            if (this.isNaN()) return Option<Int>.None();
            if (this == 0.0 or this == -0.0) return Option.Some(0);
            if (this < 0.0) return Option.Some(-1);
            return Option.Some(1);
        }
    }

    /// Whether this value is `NaN`.
    public fn isNaN(): Boolean = unsafe Double.isNaN(this);

    /// Whether this value is neither `NaN` nor infinite.
    public fn isFinite(): Boolean = unsafe Double.isFinite(this);

    /// Returns this value truncated towards zero as an `Int`, or `None` when it is `NaN` or
    /// outside the range of `Int`.
    public fn toInt(): Option<Int> = floatToInt(this);
}

external fn floatToInt(value: Float): Option<Int>;
