package zeron.lang;

import zeron.numeric.Integral;
import zeron.numeric.Integer;
import zeron.numeric.Rational;

witness Integral<Int> for Int {
    fn add(other: Int): Int = this + other;
    fn subtract(other: Int): Int = this - other;
    fn multiply(other: Int): Int = this * other;
    fn negate(): Int = -this;
    fn abs(): Int = if (this < 0) then -this else this;
    fn signum(): Int = if (this < 0) then -1 else if (this > 0) then 1 else 0;
    static fn fromInteger(value: Integer): Int = value.toIntExact();

    fn quot(other: Int): Int = this / other;
    fn rem(other: Int): Int = this % other;
    fn div(other: Int): Int {
        let quotient = this / other;
        let remainder = this % other;
        if (remainder != 0 and ((this < 0 and other > 0) or (this > 0 and other < 0))) {
            return quotient - 1;
        }
        return quotient;
    }
    fn mod(other: Int): Int {
        let remainder = this % other;
        if (remainder != 0 and ((this < 0 and other > 0) or (this > 0 and other < 0))) {
            return remainder + other;
        }
        return remainder;
    }
    fn toInteger(): Integer = Integer.fromInt(this);
    fn toRational(): Rational = Rational.fromInteger(this.toInteger());

    fn hash(): Int = this;
    fn eq(other: Int): Boolean = this == other;

    fn compareTo(other: Int): Ordering {
             if (this == other) return Ordering.EQ();
        else if (this  < other) return Ordering.LT();
        else                    return Ordering.GT();
    }
}

/// Derived properties and conversions of `Int`.
public extension Int {
    /// The sign of this integer: `-1`, `0`, or `1`.
    public property sign: Int {
        get {
            if (this == 0) return 0;
            else if (this < 0) return -1;
            else return 1;
        }
    }

    /// Returns this integer converted to a `Float`.
    ///
    /// Values that `Float` cannot represent exactly are rounded.
    public fn toFloat(): Float = intToFloat(this);

    /// Returns this integer as a `Byte`, or `None` when it is outside `0..255`.
    public fn toByte(): Option<Byte> {
        if (this < 0 or this > 255) return Option<Byte>.None();
        return Option.Some(intToByteUnchecked(this));
    }

    /// Returns this integer as a `Char` code point, or `None` when it is not a valid Unicode
    /// scalar value.
    public fn toChar(): Option<Char> {
        if (this < 0 or this > 1114111 or this >= 55296 and this <= 57343) {
            return Option<Char>.None();
        }
        return Option.Some(intToChar(this));
    }

    /// Returns this integer widened to a `Long`; the value is preserved.
    public fn toLong(): Long = intToLong(this);
}

external fn intToFloat(value: Int): Float;
external fn intToByteUnchecked(value: Int): Byte;
external fn intToChar(value: Int): Char;
external fn intToLong(value: Int): Long;
