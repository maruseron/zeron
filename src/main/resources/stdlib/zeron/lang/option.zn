package zeron.lang;

import zeron.control.Foldable;
import zeron.control.Functor;
import zeron.control.Applicative;
import zeron.control.Monad;
import zeron.control.Alternative;

/// A value that may be absent.
///
/// - `Some` holds a value of type `T`.
/// - `None` represents the absent case and carries no payload.
///
/// `Option` implements the `Monad` and `Foldable` operations through its witnesses, so the
/// generic control operations work on it as well as the members below.
public type Option<out T admits nullable + mutable> =
      Some(value: T)
    | None;

/// Operations of `Option`.
public extension<T admits nullable + mutable> Option<T> {
    /// Whether this option holds a value.
    public fn isSome(): Boolean =
        match (this) {
            case Some(_) -> true;
            case None() -> false;
        };

    /// Returns the contained value, or `other` when this option is `None`.
    ///
    /// `other` is evaluated eagerly regardless of the case.
    public fn getOrElse(other: T): T =
        if (this matches Option.Some(value)) then value else other;

    // TODO: migrate this method towards a more standard signature
    /// Reduces this option to a single value by choosing the matching branch.
    ///
    /// `ifSome` receives the contained value; `ifNone` receives no arguments.
    public fn fold<R admits mutable>(ifSome: (T) -> R, ifNone: () -> R): R =
        match (this) {
            case Some(value) -> ifSome(value);
            case None() -> ifNone();
        };

    /// Transforms the contained value, if any, leaving `None` unchanged.
    public fn map<B admits mutable>(transform: (T) -> B): Option<B> =
        match (this) {
            case Some(value) -> Option.Some(transform(value));
            case None() -> Option<B>.None();
        };

    /// Chains another optional operation on the contained value, leaving `None` unchanged.
    public fn flatMap<B admits mutable>(transform: (T) -> Option<B>): Option<B> =
        match (this) {
            case Some(value) -> transform(value);
            case None() -> Option<B>.None();
        };

    /// Keeps this option only when it holds a value that satisfies `predicate`; otherwise returns
    /// `None`.
    ///
    /// `predicate` is not called when this option is already `None`.
    public fn filter(predicate: (T) -> Boolean): Option<T> =
        match (this) {
            case Some(value) -> if (predicate(value)) then this else Option<T>.None();
            case None() -> this;
        };
}

default witness Functor<Option<_>> for Option<_> {
    fn map<A, B>(this: Option<A>, transform: (A) -> B): Option<B> =
        this.map(transform);
}

default witness Applicative<Option<_>> for Option<_> {
    fn pure<A>(value: A): Option<A> = Option.Some(value);

    fn ap<A, B>(this: Option<A>, function: Option<(A) -> B>): Option<B> =
        match (this) {
            case Some(value) -> match (function) {
                case Some(f) -> Option.Some(f(value));
                case None() -> Option<B>.None();
            };
            case None() -> Option<B>.None();
        };
}

default witness Monad<Option<_>> for Option<_> {
    fn flatMap<A, B>(this: Option<A>, transform: (A) -> Option<B>): Option<B> =
        match (this) {
            case Some(value) -> transform(value);
            case None() -> Option<B>.None();
        };
}

default witness Alternative<Option<_>> for Option<_> {
    fn empty<A>(): Option<A> = Option.None();

    fn orElse<A>(this: Option<A>, other: Option<A>): Option<A> = match (this) {
        case Some(value) -> Option.Some(value);
        case None()      -> other;
    };
}

default witness Foldable<Option<_>> for Option<_> {
    fn foldLeft<A, B>(this: Option<A>, initial: B, combine: (B, A) -> B): B =
        match (this) {
            case Some(value) -> combine(initial, value);
            case None() -> initial;
        };
}
