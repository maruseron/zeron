package zeron.lang;

public sealed contract Option<T> permits Some<T>, None<T> {
    isSome(): Boolean;
    getOrElse(defaultValue: T): T;
    fold<R>(ifSome: (T) -> R, ifNone: () -> R): R;
}

public class Some<T> is Option<T> {
    item: T;

    private constructor new;

    public constructor from(value: T) = Some<T>.new(value);

    public isSome(): Boolean = true;

    public value(): T = this.item;

    public getOrElse(defaultValue: T): T = this.item;

    public fold<R>(ifSome: (T) -> R, ifNone: () -> R): R =
        ifSome(this.item);
}

public class None<T> is Option<T> {
    private constructor new;

    public constructor none() = None<T>.new();

    public isSome(): Boolean = false;

    public getOrElse(defaultValue: T): T = defaultValue;

    public fold<R>(ifSome: (T) -> R, ifNone: () -> R): R =
        ifNone();
}

public fn someOf<T>(value: T): Option<T> = Some<T>.from(value);

public fn noneOf<T>(): Option<T> = None<T>.none();