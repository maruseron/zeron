package zeron.lang;

public type Option<T> = Some(value: T) | None;

public extension<T> Option<T> {
    public fn isSome(): Boolean = match (this) {
        case Option.Some(_) -> true;
        case Option.None() -> false;
    };

    public fn getOrElse(other: T): T =
        if (this matches Option.Some(value)) then value else other;

    public fn fold<R>(ifSome: (T) -> R, ifNone: () -> R): R = match (this) {
        case Option.Some(value) -> ifSome(value);
        case Option.None() -> ifNone();
    };

    public fn map<B>(f: (T) -> B): Option<B> = match (this) {
        case Option.Some(value) -> Option.Some(f(value));
        case Option.None()  -> Option<B>.None();
    };

    public fn filter(p: (T) -> Boolean): Option<T> = match (this) {
        case Option.Some(value) -> if (p(value)) then this else Option<T>.None();
        case Option.None()  -> this;
    };
}