package zeron.lang;

import zeron.collections.Collector;
import zeron.collections.Iterable;
import zeron.collections.Iterator;
import zeron.collections.Step;
import zeron.collections.Stream;

class StringCodePoints is Iterable<Char> {
    value: String;

    public iterator(): &Iterator<Char> {
        let text = value;
        return object: Iterator<Char> {
            value: String = text;
            offset: Int = 0;

            public mut next(): Step<Char> {
                if (this.offset >= stringLength(this.value)) return Step<Char>.Done();
                let value = stringCodePointAtOffset(this.value, this.offset);
                this.offset =
                    this.offset + stringCodePointWidthAtOffset(this.value, this.offset);
                return Step.Yield(value);
            }
        };
    }
}

/// Joins strings with a separator.
///
/// A joiner is a `Collector`, so `Stream.collect` can drive it directly and `String.join` simply
/// delegates to it. The separator is written between adjacent elements; there is no prefix or
/// suffix, and elements are not converted from another type.
public class StringJoiner is Collector<String, String> {
    separator: String;
    joined: Option<String>;

    private constructor new;

    /// Creates a joiner that writes `separator` between adjacent elements.
    public constructor withSeparator(separator: String) =
        StringJoiner.new(separator, Option<String>.None());

    /// Returns a joiner that holds `value` after the elements already collected, inserting the
    /// separator between them.
    public add(value: String): Collector<String, String> {
        let joined =
            match (this.joined) {
                case Option.Some(text) -> Option.Some(text + this.separator + value);
                case Option.None() -> Option.Some(value);
            };
        return StringJoiner.new(this.separator, joined);
    }

    /// Returns the joined text, or the empty string when nothing was added.
    public finish(): String = this.joined.getOrElse("");

    /// Adds every element of `values`, in order, and returns the joined text.
    public join(values: Iterable<String>): String = values.stream().collect(this);
}

/// A failure produced by a regular-expression operation.
public type RegexError =
      InvalidPattern(message: String);

/// Inspection and slicing of `String` values.
///
/// Bracketed operations come in two families. The plain operations index by UTF-16 code unit,
/// matching `length()`, and tolerate malformed text. The `*ByCodePoints` operations index by
/// Unicode code point, and the `*Strict` operations additionally report malformed text through
/// `UnicodeError` instead of quietly treating unpaired surrogates as single units.
public extension String {
    /// Returns the number of UTF-16 code units in this string.
    ///
    /// This is the count used by `substring` and `indexOf`, not the number of characters.
    public fn length(): Int = stringLength(this);

    /// Whether this string has no code units.
    public fn isEmpty(): Boolean = stringIsEmpty(this);

    /// Returns the code-unit index of the first occurrence of `value`, or `-1` when absent.
    public fn indexOf(value: String): Int = stringIndexOf(this, value);

    /// Returns the code-unit index of the last occurrence of `value`, or `-1` when absent.
    public fn lastIndexOf(value: String): Int = stringLastIndexOf(this, value);

    /// Whether `value` occurs anywhere in this string.
    public fn contains(value: String): Boolean = this.indexOf(value) >= 0;

    /// Whether this string starts with `prefix`.
    public fn startsWith(prefix: String): Boolean = stringStartsWith(this, prefix);

    /// Whether this string ends with `suffix`.
    public fn endsWith(suffix: String): Boolean = stringEndsWith(this, suffix);

    /// Returns the code units between `start` (inclusive) and `end` (exclusive).
    ///
    /// Returns `None` when the range is negative, out of order, or beyond `length()`. The range is
    /// measured in code units, so it may cut a surrogate pair in half; use
    /// `substringByCodePoints` to split on character boundaries.
    public fn substring(start: Int, end: Int): Option<String> {
        if (start < 0 or end < start or end > this.length()) return Option<String>.None();
        let result = stringSubstring(this, start, end);
        if (result == null) return Option<String>.None();
        return Option.Some(result);
    }

    /// Returns the number of Unicode code points, treating unpaired surrogates as single units.
    ///
    /// Use `codePointLengthStrict` when malformed text must be reported instead.
    public fn codePointLength(): Int = stringCodePointLength(this);

    /// Returns the code point at code-point index `index`, or `None` when the index is out of
    /// range.
    public fn codePointAt(index: Int): Option<Char> {
        let value = stringCodePointAt(this, index);
        if (value < 0) return Option<Char>.None();
        return Option.Some(intToChar(value));
    }

    /// Returns the substring between code-point indices `start` (inclusive) and `end`
    /// (exclusive), or `None` when the range is invalid.
    public fn substringByCodePoints(start: Int, end: Int): Option<String> {
        let result = stringSubstringByCodePoints(this, start, end);
        if (result == null) return Option<String>.None();
        return Option.Some(result);
    }

    /// Returns the code-point index of the first occurrence of `value`, or `-1` when absent.
    public fn indexOfCodePoint(value: Char): Int = stringIndexOfCodePoint(this, value);

    /// Returns this string's code points as a stream.
    public fn codePoints(): Stream<Char> = Stream<Char>.from(StringCodePoints.new(this));

    /// Returns this string's only code point, or `None` when it has none or more than one.
    public fn singleChar(): Option<Char> {
        if (this.codePointLength() != 1) return Option<Char>.None();
        return this.codePointAt(0);
    }

    /// Like `codePointLength`, but returns `Err` when the text contains an unpaired surrogate.
    public fn codePointLengthStrict(): Result<Int, UnicodeError> {
        let malformedOffset = stringFirstMalformedOffset(this);
        if (malformedOffset >= 0) {
            return Result<Int, UnicodeError>.Err(UnicodeError.MalformedSurrogate(malformedOffset));
        }
        return Result<Int, UnicodeError>.Ok(this.codePointLength());
    }

    /// Like `codePointAt`, but returns `Err` when the text contains an unpaired surrogate.
    public fn codePointAtStrict(index: Int): Result<Option<Char>, UnicodeError> {
        let malformedOffset = stringFirstMalformedOffset(this);
        if (malformedOffset >= 0) {
            return Result<Option<Char>, UnicodeError>.Err(
                UnicodeError.MalformedSurrogate(malformedOffset)
            );
        }
        return Result<Option<Char>, UnicodeError>.Ok(this.codePointAt(index));
    }

    /// Like `substringByCodePoints`, but returns `Err` when the text contains an unpaired
    /// surrogate.
    public fn substringByCodePointsStrict(
        start: Int,
        end: Int
    ): Result<Option<String>, UnicodeError> {
        let malformedOffset = stringFirstMalformedOffset(this);
        if (malformedOffset >= 0) {
            return Result<Option<String>, UnicodeError>.Err(
                UnicodeError.MalformedSurrogate(malformedOffset)
            );
        }
        return Result<Option<String>, UnicodeError>.Ok(this.substringByCodePoints(start, end));
    }

    /// Like `indexOfCodePoint`, but returns `Err` when the text contains an unpaired surrogate.
    public fn indexOfCodePointStrict(value: Char): Result<Int, UnicodeError> {
        let malformedOffset = stringFirstMalformedOffset(this);
        if (malformedOffset >= 0) {
            return Result<Int, UnicodeError>.Err(UnicodeError.MalformedSurrogate(malformedOffset));
        }
        return Result<Int, UnicodeError>.Ok(this.indexOfCodePoint(value));
    }

    /// Like `codePoints`, but returns `Err` when the text contains an unpaired surrogate.
    public fn codePointsStrict(): Result<Stream<Char>, UnicodeError> {
        let malformedOffset = stringFirstMalformedOffset(this);
        if (malformedOffset >= 0) {
            return Result<Stream<Char>, UnicodeError>.Err(
                UnicodeError.MalformedSurrogate(malformedOffset)
            );
        }
        return Result<Stream<Char>, UnicodeError>.Ok(this.codePoints());
    }

    /// Like `singleChar`, but returns `Err` when the text contains an unpaired surrogate.
    public fn singleCharStrict(): Result<Option<Char>, UnicodeError> {
        let malformedOffset = stringFirstMalformedOffset(this);
        if (malformedOffset >= 0) {
            return Result<Option<Char>, UnicodeError>.Err(
                UnicodeError.MalformedSurrogate(malformedOffset)
            );
        }
        return Result<Option<Char>, UnicodeError>.Ok(this.singleChar());
    }

    /// Returns the character at UTF-16 code-unit index `index`, or `None` when the index is out of
    /// range or points at the second unit of a surrogate pair.
    ///
    /// The index is measured in code units, like `length()` and `substring`. An unpaired surrogate
    /// is reported as U+FFFD, matching the scalar operations.
    public fn charAt(index: Int): Option<Char> {
        let value = stringCharCodePointAt(this, index);
        if (value < 0) return Option<Char>.None();
        return Option.Some(intToChar(value));
    }

    /// Alias of `charAt`, for code that reads collections with `at`.
    public fn at(index: Int): Option<Char> = this.charAt(index);

    /// Returns the parts of this string separated by `separator`.
    ///
    /// `separator` is literal text, not a pattern, and empty parts are preserved, including a
    /// leading, repeated, or trailing one: `"a,".split(",")` is `["a", ""]` and
    /// `"".split(",")` is `["", ""]`.
    ///
    /// An empty separator splits into Unicode scalar values, so `"abc".split("")` is
    /// `["a", "b", "c"]` and `"".split("")` is empty. Malformed text is normalized to U+FFFD.
    /// A single-character separator is written as text: `text.split(" ")`.
    public fn split(separator: String): Stream<String> =
        Stream<String>.fromArray(stringSplit(this, separator));

    /// Returns the parts of this string separated by the regular expression `regex`.
    ///
    /// The expression uses the host regular-expression dialect. An invalid expression returns
    /// `RegexError.InvalidPattern` instead of failing; use `split` for literal separators.
    public fn splitRegex(regex: String): Result<Stream<String>, RegexError> {
        let message = stringRegexErrorMessage(regex);
        if (message != null) {
            return Result<Stream<String>, RegexError>.Err(RegexError.InvalidPattern(message));
        }
        return Result<Stream<String>, RegexError>.Ok(
            Stream<String>.fromArray(stringSplitRegex(this, regex))
        );
    }

    /// Returns this string with every character mapped to lower case.
    ///
    /// The mapping is locale-independent and performs no normalization or grapheme-aware casing.
    public fn toLowerCase(): String = stringToLowerCase(this);

    /// Returns this string with every character mapped to upper case.
    public fn toUpperCase(): String = stringToUpperCase(this);

    /// Returns this string with its leading and trailing whitespace removed.
    public fn trim(): String = stringTrim(this);

    /// Returns this string with its leading whitespace removed.
    public fn trimStart(): String = stringTrimStart(this);

    /// Returns this string with its trailing whitespace removed.
    public fn trimEnd(): String = stringTrimEnd(this);

    /// Whether this string is empty or holds only whitespace.
    public fn isBlank(): Boolean = stringIsBlank(this);

    /// Returns this string with every non-overlapping occurrence of `target` replaced by
    /// `replacement`.
    ///
    /// `target` is literal text, not a pattern.
    public fn replace(target: String, replacement: String): String =
        stringReplace(this, target, replacement);

    /// Returns this string's lines as a stream.
    ///
    /// Lines end at `\n`, `\r\n`, or `\r`. A terminal line break does not add an empty line, and an
    /// empty input has no lines.
    public fn lines(): Stream<String> = Stream<String>.fromArray(stringLines(this));

    /// Parses this string as a decimal `Int`.
    ///
    /// Accepts an optional leading sign followed by one or more decimal digits, with no surrounding
    /// whitespace. Returns `None` for invalid or out-of-range text; callers trim first when
    /// surrounding whitespace is acceptable.
    public fn toInt(): Option<Int> {
        if (not stringIsDecimalInt(this)) return Option<Int>.None();
        return Option.Some(stringToInt(this));
    }

    /// Parses this string as a decimal `Float`.
    ///
    /// Accepts the ordinary decimal and exponent forms, with no surrounding whitespace. Returns
    /// `None` for invalid or non-finite text.
    public fn toFloat(): Option<Float> {
        if (not stringIsDecimalFloat(this)) return Option<Float>.None();
        return Option.Some(stringToFloat(this));
    }
}

/// Functions of `String` that are not receiver methods.
namespace String {
    /// Joins `values` into one string, inserting `separator` between adjacent elements.
    ///
    /// `String.join` delegates to `StringJoiner`; use that type directly to join a stream or to
    /// reuse one separator across calls.
    public fn join(separator: String, values: Iterable<String>): String =
        StringJoiner.withSeparator(separator).join(values);
}

external fn stringLength(value: String?): Int;
external fn stringIsEmpty(value: String?): Boolean;
external fn stringIndexOf(value: String?, search: String?): Int;
external fn stringLastIndexOf(value: String?, search: String?): Int;
external fn stringStartsWith(value: String?, prefix: String?): Boolean;
external fn stringEndsWith(value: String?, suffix: String?): Boolean;
external fn stringSubstring(value: String?, start: Int, end: Int): String?;
external fn stringCodePointLength(value: String?): Int;
external fn stringCodePointAt(value: String?, index: Int): Int;
external fn stringSubstringByCodePoints(value: String?, start: Int, end: Int): String?;
external fn stringIndexOfCodePoint(value: String?, codePoint: Char): Int;
external fn stringFirstMalformedOffset(value: String?): Int;
external fn stringCodePointAtOffset(value: String?, offset: Int): Char;
external fn stringCodePointWidthAtOffset(value: String?, offset: Int): Int;
external fn stringCharCodePointAt(value: String?, index: Int): Int;
external fn stringToLowerCase(value: String?): String;
external fn stringToUpperCase(value: String?): String;
external fn stringTrim(value: String?): String;
external fn stringTrimStart(value: String?): String;
external fn stringTrimEnd(value: String?): String;
external fn stringIsBlank(value: String?): Boolean;
external fn stringReplace(value: String?, target: String?, replacement: String?): String;
external fn stringSplit(value: String?, separator: String?): Array<String>;
external fn stringRegexErrorMessage(regex: String?): String?;
external fn stringSplitRegex(value: String?, regex: String?): Array<String>;
external fn stringLines(value: String?): Array<String>;
external fn stringIsDecimalInt(value: String?): Boolean;
external fn stringToInt(value: String?): Int;
external fn stringIsDecimalFloat(value: String?): Boolean;
external fn stringToFloat(value: String?): Float;
