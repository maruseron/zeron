package zeron.math;

import java.lang.Math;

public extension Int {
    public fn abs(): Int = Math.abs(this);

    public fn min(other: Int): Int = Math.min(this, other);

    public fn max(other: Int): Int = Math.max(this, other);

    public fn clamp(min: Int, max: Int): Int = Math.clamp(this.toLong(), min, max);
}

public extension Long {
    public fn abs(): Long = Math.abs(this);

    public fn min(other: Long): Long = Math.min(this, other);

    public fn max(other: Long): Long = Math.max(this, other);

    public fn clamp(min: Long, max: Long): Long = Math.clamp(this, min, max);
}

public extension Float {
    public fn abs(): Float = Math.abs(this);

    public fn min(other: Float): Float = Math.min(this, other);

    public fn max(other: Float): Float = Math.max(this, other);

    public fn clamp(min: Float, max: Float): Float = Math.clamp(this, min, max);

    public fn sqrt(): Float = Math.sqrt(this);

    public fn pow(exponent: Float): Float = Math.pow(this, exponent);

    public fn exp(): Float = Math.exp(this);

    public fn ln(): Float = Math.log(this);

    public fn log10(): Float = Math.log10(this);

    public fn sin(): Float = Math.sin(this);

    public fn cos(): Float = Math.cos(this);

    public fn tan(): Float = Math.tan(this);

    public fn asin(): Float = Math.asin(this);

    public fn acos(): Float = Math.acos(this);

    public fn atan(): Float = Math.atan(this);

    public fn atan2(x: Float): Float = Math.atan2(this, x);

    public fn floor(): Float = Math.floor(this);

    public fn ceil(): Float = Math.ceil(this);

    public fn trunc(): Float {
        if (this < 0.0) return Math.ceil(this);
        return Math.floor(this);
    }

    public fn round(): Long = Math.round(this);
}

public let PI: Float = 3.141592653589793;

public let TAU: Float = 6.283185307179586;

public let E: Float = 2.718281828459045;
