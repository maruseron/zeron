package zeron.ranges;

import zeron.collections.Iterator;
import zeron.collections.Iterable;
import zeron.lang.Option;
import zeron.lang.Some;
import zeron.lang.None;

public class IntIterator is Iterator<Int> {
    current: Int;
    end: Int;
    step: Int;
    done: Boolean;

    private constructor new;

    public constructor ascending(current: Int, end: Int) =
        IntIterator.new(current, end, 1, false);

    public constructor descending(current: Int, end: Int) =
        IntIterator.new(current, end, -1, false);

    public mut next(): Option<Int> {
        if (this.done) return None<Int>.none();
        if (this.step > 0 and this.current > this.end) return None<Int>.none();
        if (this.step < 0 and this.current < this.end) return None<Int>.none();
        let temp = this.current;
        if (this.current == this.end) {
            this.done = true;
        } else {
            this.current = this.current + this.step;
        }
        return Some<Int>.from(temp);
    }
}

public class IntRange is Iterable<Int> {
    start: Int;
    end: Int;
    step: Int;

    private constructor new;

    public constructor ascending(start: Int, end: Int) =
        IntRange.new(start, end, 1);

    public constructor descending(start: Int, end: Int) =
        IntRange.new(start, end, -1);

    public constructor closed(start: Int, end: Int) =
        IntRange.new(start, end, if (start <= end) then 1 else -1);

    public iterator(): &Iterator<Int> {
        if (this.step > 0) {
            return IntIterator.ascending(this.start, this.end);
        } else {
            return IntIterator.descending(this.start, this.end);
        }
    }
}