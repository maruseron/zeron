package zeron.serialization.json;

import zeron.lang.Result;
import com.maruseron.zeron.runtime.json.JsonArray;
import com.maruseron.zeron.runtime.json.JsonErrorInfo;
import com.maruseron.zeron.runtime.json.JsonObject;
import com.maruseron.zeron.runtime.json.JsonParseResult;
import com.maruseron.zeron.runtime.json.JsonSupport;
import com.maruseron.zeron.runtime.json.JsonTextResult;
import com.maruseron.zeron.runtime.json.JsonValue;

public type JsonError = (message: String, offset: Int, line: Int, column: Int);

public fn parse(text: String): Result<&JsonValue, JsonError> {
    let result = JsonSupport.parse(text);
    if (result.isSuccess()) return Result.Ok(result.value());
    let error = result.error();
    return Result.Err(JsonError.new(
        error.message(),
        error.offset(),
        error.line(),
        error.column()
    ));
}

public fn number(lexeme: String): Result<&JsonValue, JsonError> {
    let result = JsonSupport.number(lexeme);
    if (result.isSuccess()) return Result.Ok(result.value());
    let error = result.error();
    return Result.Err(JsonError.new(
        error.message(),
        error.offset(),
        error.line(),
        error.column()
    ));
}

public fn stringify(value: &JsonValue): Result<String, JsonError> {
    let result = JsonSupport.stringify(value);
    if (result.isSuccess()) return Result.Ok(result.text());
    let error = result.error();
    return Result.Err(JsonError.new(
        error.message(),
        error.offset(),
        error.line(),
        error.column()
    ));
}

public fn nullValue(): &JsonValue = JsonValue.nullValue();
public fn booleanValue(value: Boolean): &JsonValue = JsonValue.booleanValue(value);
public fn newArray(): &JsonArray = JsonArray.new();
public fn newObject(): &JsonObject = JsonObject.new();
