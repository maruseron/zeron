package zeron.test;

/// Marks a top-level, public, parameterless `Unit` function as a test.
public annotation Test on FUNCTION;

/// Marks a `@Test` function as skipped. The optional reason is reported by the test runner.
public annotation Ignore(reason: String = "") on FUNCTION;

/// Raised by an assertion to report a test failure.
public effect TestFailure {
    public property message: String;
}

/// Fails the current test with `message`.
public fn fail(message: String): Unit raises TestFailure =
    raise TestFailure.new(message);

/// Fails unless `condition` is true.
public fn assertTrue(
    condition: Boolean,
    message: String = "expected condition to be true"
): Unit raises TestFailure {
    if (condition == false) raise TestFailure.new(message);
}

/// Fails when `condition` is true.
public fn assertFalse(
    condition: Boolean,
    message: String = "expected condition to be false"
): Unit raises TestFailure {
    if (condition) raise TestFailure.new(message);
}

/// Fails unless `expected` and `actual` are equal.
public fn assertEquals<T: Eq<T> + Display>(
    expected: T,
    actual: T,
    message: String = ""
): Unit raises TestFailure {
    if (expected != actual) {
        raise TestFailure.new(if (message.isEmpty())
            then "expected " + expected.toString() + ", got " + actual.toString()
            else message);
    }
}

/// Fails when `unexpected` and `actual` are equal.
public fn assertNotEquals<T: Eq<T> + Display>(
    unexpected: T,
    actual: T,
    message: String = ""
): Unit raises TestFailure {
    if (unexpected == actual) {
        raise TestFailure.new(if (message.isEmpty())
            then "expected values to differ, got " + actual.toString()
            else message);
    }
}

/// Fails unless `value` is null.
public fn assertNull<T: nullable>(value: T?, message: String = "expected a null value"): Unit
        raises TestFailure {
    if (value != null) raise TestFailure.new(message);
}

/// Fails when `value` is null.
public fn assertNotNull<T: nullable>(
    value: T?,
    message: String = "expected a non-null value"
): Unit raises TestFailure {
    if (value == null) raise TestFailure.new(message);
}

/// Fails unless `actual` is within `tolerance` of `expected`.
public fn assertApproximatelyEquals(
    expected: Float,
    actual: Float,
    tolerance: Float,
    message: String = ""
): Unit raises TestFailure {
    if (actual > expected and actual - expected > tolerance
            or expected > actual and expected - actual > tolerance) {
        raise TestFailure.new(if (message.isEmpty())
            then "expected " + expected.toString() + " +/- " + tolerance.toString()
                + ", got " + actual.toString()
            else message);
    }
}
