let s = "hello " + "world";

let i = 5 + 1;

let f = 5.3;

let bool = true;
let mut globalCount = 1;

let theUnit = unit;

let maybeInt: Int? = 7;
let emptyInt: Int? = null;
let maybeFloat: Float? = 2.5;
let maybeBool: Boolean? = true;
let maybeText: String? = "present";
let emptyText: String? = null;

fn adder(a: Float, b: Float) = a + b;

fn apply(value: Int, operation: (Int) -> Int): Int {
    return operation(value);
}

fn applyFloat(value: Float, operation: (Float) -> Float): Float {
    return operation(value);
}

fn applyString(value: String, operation: (String) -> String): String {
    return operation(value);
}

fn passNullableInt(value: Int?): Int? {
    return value;
}

fn firstArrayValue(values: Array<Int>): Int = values[0];

contract TestCounterView {
    read(): Int;
}

class TestCounter is TestCounterView {
    value: Int;
    public constructor new;

    public read(): Int = this.value;

    public mut increment(): Unit {
        this.incrementInternal();
    }

    private mut incrementInternal(): Unit {
        this.value = this.value + 1;
    }
}

fn main() {
    globalCount += 2;
    print(globalCount);

    let mut localCount = 4;
    localCount = localCount + 3;
    print(localCount);
    {
        let mut localCount = 20;
        localCount += 2;
        print(localCount);
    }
    localCount += 1;
    print(localCount);
    let assignmentValue = localCount = 9;
    print(assignmentValue);
    print(localCount);

    let inner = 5;
    if (bool) {
        print(inner);
    } else {
        print("hello world");
    }
    let addOne = x -> x + 1;
    let combine = (left, right) -> left + right;
    let base = 7;
    let addBase = value -> value + base;
    let greeting = "hello";
    let decorate = text -> greeting + " " + text;
    print(addBase(5));
    print(decorate("world"));
    let noParam = () -> 99;
    print(addOne(10));
    print(combine(3, 7));
    print(noParam());
    print(apply(41, addOne));
    print(apply(21, y -> y * 2));
    print(applyFloat(2.5, number -> number * 2.0));
    print(applyString("zeron", text -> text + "!"));
    let localMaybe: Int? = 3;
    let localNull: Int? = null;
    let localDefault: Int?;
    print(localMaybe);
    print(localNull);
    print(localDefault);
    print(maybeInt);
    print(emptyInt);
    print(maybeFloat);
    print(maybeBool);
    print(maybeText);
    print(emptyText);
    print(passNullableInt(9));
    print(passNullableInt(null));

    let mutableView: &Array<Int> = [11, 22, 33];
    let readOnlyView: Array<Int> = mutableView;
    print(firstArrayValue(mutableView));
    print(readOnlyView.length);
    mutableView[1] = 44;
    print(readOnlyView[1]);

    let mut rebindableView: Array<Int> = [1, 2];
    rebindableView = [3, 4];
    print(rebindableView[0]);

    let nullableSlots: &Array<Int?> = [7, null, 9];
    print(nullableSlots[1]);

    let mut whileCount = 0;
    while (whileCount < 2) {
        whileCount += 1;
    }
    print(whileCount);

    let mut untilCount = 0;
    until (untilCount == 2) {
        untilCount += 1;
    }
    print(untilCount);

    let mut loopCount = 0;
    loop {
        loopCount += 1;
        loop {
            loopCount += 10;
            break;
        }
        break;
    }
    print(loopCount);

    let counter = TestCounter.new(40);
    counter.increment();
    let counterView: TestCounterView = counter;
    print(counterView.read());
 }