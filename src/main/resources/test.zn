import zeron.io.println;

let s = "hello " + "world";

let i = 5 + 1;

let f = 5.3;

let bool = true;
let mut globalCount = 1;

let theUnit = unit;

let maybeInt: Int? = 7;
let emptyInt: Int? = null;
let maybeFloat: Float? = 2.5;
let maybeBool: Boolean? = true;
let maybeText: String? = "present";
let emptyText: String? = null;

fn adder(a: Float, b: Float) = a + b;

fn apply(value: Int, operation: (Int) -> Int): Int {
    return operation(value);
}

fn applyFloat(value: Float, operation: (Float) -> Float): Float {
    return operation(value);
}

fn applyString(value: String, operation: (String) -> String): String {
    return operation(value);
}

fn passNullableInt(value: Int?): Int? {
    let polymorphicIdentity = value -> value;
    return value;
}

fn firstArrayValue(values: Array<Int>): Int = values[0];

fn identity<T>(value: T): T = value;
fn echoAny(value: Any): Any = value;

fn applyGeneric<T, R>(value: T, transform: (T) -> R): R = transform(value);

class TestBox<T> {
    value: T;
    public constructor new;

    public readValue(): T = this.value;
}

contract TestEcho<T> {
    echo(value: T): T;
}

class TestIntEcho is TestEcho<Int> {
    public constructor new;

    public echo(value: Int): Int = value;
}

class TestFactoryCounter {
    count: Int;
    private constructor new;

    public constructor fromCount(count: Int) = TestFactoryCounter.new(count);

    public constructor incremented(count: Int) {
        let counter = TestFactoryCounter.new(count);
        counter.count = counter.count + 1;
        return counter;
    }

    public readCount(): Int = this.count;
}

contract TestCounterView {
    read(): Int;
}

class TestCounter is TestCounterView {
    value: Int;
    public constructor new;

    public read(): Int = this.value;

    public mut increment(): Unit {
        this.incrementInternal();
    }

    private mut incrementInternal(): Unit {
        this.value = this.value + 1;
    }
}

contract TestNamed {
    name(): String;
}

class TestFirstName is TestNamed {
    value: String;
    public constructor new;

    public name(): String = this.value;
}

class TestSecondName is TestNamed {
    value: String;
    public constructor new;

    public name(): String = this.value;
}

fn nameOrUnknown(value: Any?): String {
    if (value is TestFirstName or value is TestSecondName) {
        return value.name();
    }
    return "unknown";
}

fn testGenericBox(): Int {
    let box = TestBox<Int>.new(40);
    return box.readValue();
}

fn testGenericContract(): Int {
    let echo: TestEcho<Int> = TestIntEcho.new();
    return echo.echo(42);
}

fn testNamedExpressionFactory(): Int = TestFactoryCounter.fromCount(20).readCount();
fn testNamedBlockFactory(): Int = TestFactoryCounter.incremented(30).readCount();

fn main() {
    globalCount += 2;
    println(globalCount);

    let mut localCount = 4;
    localCount = localCount + 3;
    println(localCount);
    {
        let mut localCount = 20;
        localCount += 2;
        println(localCount);
    }
    localCount += 1;
    println(localCount);
    let assignmentValue = localCount = 9;
    println(assignmentValue);
    println(localCount);

    let inner = 5;
    if (bool) {
        println(inner);
    } else {
        println("hello world");
    }
    let addOne = x -> x + 1;
    let combine = (left, right) -> left + right;
    let base = 7;
    let addBase = value -> value + base;
    let greeting = "hello";
    let decorate = text -> greeting + " " + text;
    println(addBase(5));
    println(decorate("world"));
    let noParam = () -> 99;
    println(addOne(10));
    println(combine(3, 7));
    println(noParam());
    let polymorphicIdentity = value -> value;
    println(polymorphicIdentity(12));
    println(polymorphicIdentity("polymorphic"));
    println(apply(41, addOne));
    println(apply(21, y -> y * 2));
    println(applyFloat(2.5, number -> number * 2.0));
    println(applyString("zeron", text -> text + "!"));
    println(identity(42));
    println(identity<String>("generic"));
    println(17 % 5);
    println(12 & 10);
    println(1 << 3);
    println(-8 >>> 1);
    let mut operatorValue = 42;
    operatorValue %= 5;
    operatorValue |= 8;
    operatorValue ^= 3;
    operatorValue &= 7;
    operatorValue <<= 3;
    operatorValue >>= 1;
    operatorValue >>>= 1;
    println(operatorValue);
    let explicitIdentity: (Int) -> Int = identity::<Int>;
    let expectedIdentity: (String) -> String = identity;
    println(explicitIdentity(17));
    println(expectedIdentity("expected"));
    println(applyGeneric(23, identity));
    println(identity::<Int>(24));
    println(echoAny(42));
    let unitAsAny: Any = unit;
    let nullAsAny: Any? = null;
    println(unitAsAny);
    println(nullAsAny);
    println(nameOrUnknown(TestFirstName.new("Ada")));
    println(nameOrUnknown(TestSecondName.new("Grace")));
    println(nameOrUnknown(42));
    println(applyGeneric(6, value -> value * 3));
    println(testGenericBox());
    println(testGenericContract());
    println(testNamedExpressionFactory());
    println(testNamedBlockFactory());
    let localMaybe: Int? = 3;
    let localNull: Int? = null;
    let localDefault: Int?;
    println(localMaybe);
    println(localNull);
    println(localDefault);
    println(maybeInt);
    println(emptyInt);
    println(maybeFloat);
    println(maybeBool);
    println(maybeText);
    println(emptyText);
    println(passNullableInt(9));
    println(passNullableInt(null));

    let mutableView: &Array<Int> = [11, 22, 33];
    let readOnlyView: Array<Int> = mutableView;
    println(firstArrayValue(mutableView));
    println(readOnlyView.length);
    mutableView[1] = 44;
    println(readOnlyView[1]);

    let mut rebindableView: Array<Int> = [1, 2];
    rebindableView = [3, 4];
    println(rebindableView[0]);

    let nullableSlots: &Array<Int?> = [7, null, 9];
    println(nullableSlots[1]);

    let values: Array<Int> = [2, 3, 5];
    let mut arrayTotal = 0;
    for (let value in values) {
        arrayTotal += value;
    }
    println(arrayTotal);

    let mut ascendingTotal = 0;
    for (let value in 1..4) {
        ascendingTotal += value;
    }
    println(ascendingTotal);

    let mut descendingTotal = 0;
    for (let value in 4..1) {
        descendingTotal += value;
    }
    println(descendingTotal);

    let mut whileCount = 0;
    while (whileCount < 2) {
        whileCount += 1;
    }
    println(whileCount);

    let mut untilCount = 0;
    until (untilCount == 2) {
        untilCount += 1;
    }
    println(untilCount);

    let mut loopCount = 0;
    loop {
        loopCount += 1;
        loop {
            loopCount += 10;
            break;
        }
        break;
    }
    println(loopCount);

    let counter = TestCounter.new(40);
    counter.increment();
    let counterView: TestCounterView = counter;
    println(counterView.read());
 }