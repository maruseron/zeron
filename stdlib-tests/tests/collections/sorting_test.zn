package collections;

import zeron.collections.ArrayList;
import zeron.collections.ConsList;
import zeron.collections.LinkedList;
import zeron.collections.Stream;
import zeron.test.Test;
import zeron.test.TestFailure;
import zeron.test.assertEquals;

@Test
public fn sortedCopyLeavesTheSourceUnchanged(): Unit performs TestFailure {
    let values = ArrayList.of(3, 1, 2);
    let sorted = values.sorted();
    assertEquals("1,2,3|3", sorted.at(0).getOrElse(0).toString() + ","
        + sorted.at(1).getOrElse(0).toString() + ","
        + sorted.at(2).getOrElse(0).toString() + "|"
        + values.at(0).getOrElse(0).toString());
}

@Test
public fn arrayListSortsInPlaceByComparator(): Unit performs TestFailure {
    let mut values = ArrayList.of(1, 3, 2);
    values.sortBy((a, b) -> b.compareTo(a));
    assertEquals("321", values.at(0).getOrElse(0).toString()
        + values.at(1).getOrElse(0).toString()
        + values.at(2).getOrElse(0).toString());
}

@Test
public fn linkedListSortsInPlace(): Unit performs TestFailure {
    let mut values = LinkedList.of(3, 1, 2);
    values.sort();
    assertEquals("123", values.at(0).getOrElse(0).toString()
        + values.at(1).getOrElse(0).toString()
        + values.at(2).getOrElse(0).toString());
}

@Test
public fn consListSortedCopyKeepsTheOriginalHead(): Unit performs TestFailure {
    let values = ConsList.of(3, 1, 2);
    let sorted = values.sorted();
    assertEquals("133", sorted.first().getOrElse(0).toString()
        + values.first().getOrElse(0).toString()
        + sorted.last().getOrElse(0).toString());
}

@Test
public fn streamSortsByComparator(): Unit performs TestFailure {
    let values = Stream<String>.fromArray(["ccc", "a", "bb"])
        .sortedBy((a, b) -> a.length().compareTo(b.length()))
        .toList();
    assertEquals("abbccc", values.at(0).getOrElse("") + values.at(1).getOrElse("")
        + values.at(2).getOrElse(""));
}

@Test
public fn sortedStreamIsReplayable(): Unit performs TestFailure {
    let values = Stream<Int>.fromArray([2, 1])
        .sortedBy((a, b) -> a.compareTo(b));
    let count = values.count();
    assertEquals("2:1", count.toString() + ":"
        + values.toList().at(0).getOrElse(0).toString());
}

@Test
public fn splitWhitespaceSkipsRunsAndBlankText(): Unit performs TestFailure {
    let parts = "  alpha\tbeta\n gamma  ".splitWhitespace().toList();
    assertEquals("3:alpha,gamma", parts.size.toString() + ":"
        + parts.at(0).getOrElse("") + "," + parts.at(2).getOrElse(""));
    assertEquals(0, " \t\n ".splitWhitespace().count());
}
